  6:{role:'Jefatura de Soporte Vital', ability:'Responde por la salud de los cuatro que van adentro.', color:'var(--rose)'},
};
function avatarBadge(sysId){
  switch(sysId){
    case 1: return '<polygon points="50,34 60,54 40,54"></polygon>';
    case 2: return '<circle cx="50" cy="46" r="10"></circle><circle cx="50" cy="46" r="4" class="fill"></circle>';
    case 3: return '<polygon points="50,36 60,46 50,56 40,46"></polygon>';
    case 4: return '<rect x="37" y="48" width="5" height="10"></rect><rect x="45" y="42" width="5" height="16"></rect><rect x="53" y="36" width="5" height="22"></rect>';
    case 5: return '<polygon points="50,32 62,38 62,52 50,60 38,52 38,38"></polygon>';
    case 6: return '<rect x="45" y="34" width="10" height="24"></rect><rect x="38" y="41" width="24" height="10"></rect>';
    default: return '';
  }
}
function avatarSVG(sysId, size, cls){
  const color = (AVATARS[sysId] && AVATARS[sysId].color) || 'var(--accent-2)';
  return `<svg class="avatar ${cls||''}" width="${size||64}" height="${size||64}" viewBox="0 0 100 100" style="--ac:${color}">
    <circle class="avatar-halo" cx="50" cy="44" r="33"></circle>
    <polygon class="avatar-collar" points="26,72 74,72 86,100 14,100"></polygon>
    <rect class="avatar-seam" x="32" y="77" width="36" height="3" rx="1.5"></rect>
    <circle class="avatar-stud" cx="31" cy="88" r="2.6"></circle>
    <circle class="avatar-stud" cx="69" cy="88" r="2.6"></circle>
    <circle class="avatar-helmet" cx="50" cy="44" r="28"></circle>
    <path class="avatar-rim" d="M23,40 A27,27 0 0 1 74,34"></path>
    <g class="avatar-badge">${avatarBadge(sysId)}</g>
    <path class="avatar-shine" d="M29,32 Q36,20 52,21"></path>
    <line class="avatar-antenna" x1="70" y1="24" x2="77" y2="13"></line>
    <circle class="avatar-antenna-tip" cx="77" cy="13" r="2.6"></circle>
  </svg>`;
}
const VERIF_PRESETS = {
  GO: ['Sala de sistemas confirma GO. No hay objeciones formales.', 'Sala de sistemas autoriza el lanzamiento sin objeciones.', 'GO confirmado por toda la sala.'],
  COND: ['Sala de sistemas confirma GO con condición. Vigilar en vuelo.', 'Lanzamiento autorizado con monitoreo activo en ascenso.', 'GO con condición: revisar telemetría todo el vuelo.'],
  NOGO: ['Sala de sistemas confirma NO GO. Se aborta por precaución.', 'NO GO: la sala no autoriza el lanzamiento.', 'Se aborta la misión hasta la próxima ventana.'],
};
const REFLECTION_PRESETS = [
  'Porque parecía que probablemente no iba a pasar nada.',
  'Porque decirlo me exponía a mí, no a la nave.',
  'Porque ya no había tiempo para arreglarlo.',
  'Porque alguien con más experiencia dijo que estaba bien.',
  'Porque el grupo ya había decidido, y no quise frenar todo.',
  'No me lo guardé: dije todo lo que sabía.',
  'Porque el consejero dijo que estaba bien, y hasta ese momento no se había equivocado.',
  'Porque nadie más lo mencionó, y no quise ser el único.',
  'Porque no hablar era lo más simple, y a mí no me iba a pasar nada.',
];
const DELAY_HOURS = {1:48, 2:24, 3:72, 4:8, 5:168, 6:336};
const TOTAL_DELAY_HOURS = Object.values(DELAY_HOURS).reduce((a,b)=>a+b,0);
function formatDuration(hours){
  const unit = (n,s,p)=> n+' '+(n===1?s:p);
  if(hours<20) return unit(hours,'hora','horas');
  const days = Math.round(hours/24);
  if(days<12) return unit(days,'día','días');
  const weeks = Math.round(days/7);
  if(weeks<7) return unit(weeks,'semana','semanas');
  const months = Math.round(days/30);
  return unit(months,'mes','meses');
}

const INFORME = [
  'PROPULSIÓN: la válvula nueva nunca se probó en frío, y esta madrugada hizo más frío de lo previsto.',
  'OXÍGENO: el margen de la fuga se calculó para seis días y la misión es de nueve.',
  'NAVEGACIÓN: el sistema de respaldo lleva tres días con un error intermitente.',
  'COMUNICACIONES: la antena secundaria está desalineada dos grados.',
  'ESCUDO TÉRMICO: hay una placa fisurada que el manual manda reemplazar.',
  'SOPORTE VITAL: los filtros de repuesto entraron sin certificado de calidad.',
];

const PHASES = [
  {id:'lectura',  at:0,   dur:60,  code:'T MENOS 20:00', label:'Lectura de protocolo'},
  {id:'sistemas', at:60,  dur:840, code:'T MENOS 19:00', label:'Sistemas y discusión'},
  {id:'entrega',  at:900, dur:300, code:'T MENOS 5:00',  label:'Firma y lanzamiento'},
];
const TOTAL = 1200;

function loadJSON(key, fallback){ try{ const v = localStorage.getItem(key); return v ? JSON.parse(v) : fallback; }catch(e){ return fallback; } }
function saveJSON(key, val){ try{ localStorage.setItem(key, JSON.stringify(val)); }catch(e){} }

let S = {
  nav:'inicio', introStep:0,
  screen:'setup', view:'mission',
  count:6, selectedSystems:[1,2,3,4,5,6],
  participants:[], running:false, elapsed:0, _lastPhase:null,
  sys:{idx:0, q1:null, miniDone:false, ttt:null, miniResult:null},
  decision:null, verifText:'',
  watchedSystems:[],
  savedRound:false, reflectionSubmitted:0,
  _bitStore:{}, launch:null, fixedDelayHours:0,
  tableroDesde:'', tableroHasta:'',
};
let timerHandle = null;

function fmt(sec){
  sec = Math.max(0, sec);
  const m = Math.floor(sec/60), s = sec%60;
  return String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');
}
function currentPhase(){
  let ph = PHASES[0];
  for(const p of PHASES){ if(S.elapsed >= p.at) ph = p; }
  return ph;
}
function phaseIndex(){ return PHASES.findIndex(p=>p.id===currentPhase().id); }

function shuffle(arr){
  const a = arr.slice();
  for(let i=a.length-1;i>0;i--){ const j = Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; }
  return a;
}

function resetSubstateFor(id){
  if(id==='sistemas') S.sys = {idx:0, q1:null, miniDone:false, ttt:null, miniResult:null, talkPending:false, deciding:false, firedPending:false, firedWait:0, firedName:'', firedReason:'', clearedPending:false, clearedName:'', fixName:'', fixHours:0};
}

function startMission(){
  if(S.selectedSystems.length !== S.count) return;
  const pool = shuffle(S.selectedSystems);
  S.participants = [];
  for(let i=0;i<S.count;i++){
    S.participants.push({name:'Jugador '+(i+1), cardId:pool[i], fired:false, credited:null});
  }
  S.elapsed = 0; S.running = true; S._lastPhase = null;
  S.sys = {idx:0, q1:null, miniDone:false, ttt:null, miniResult:null, talkPending:false, deciding:false, firedPending:false, firedWait:0, firedName:'', firedReason:'', clearedPending:false, clearedName:'', fixName:'', fixHours:0};
  S._bitStore = {};
  S.fixedDelayHours = 0;
  S.decision = null; S.verifText='';
  S.watchedSystems = [];
  S.savedRound = false; S.reflectionSubmitted=0;
  S.launch = null;
  S.screen = 'mission'; S.view = 'mission';
  render();
  runTimer();
  showToast('🚀 Cuenta regresiva iniciada', 'go', 3000);
  // Anuncio de inicio
  setTimeout(() => Anuncios?.decir?.('bienvenida'), 500);
}

function runTimer(){
  clearInterval(timerHandle);
  timerHandle = setInterval(()=>{
    if(!S.running) return;
    const busy = S.sys && (S.sys.deciding || S.sys.firedPending || S.sys.clearedPending || S.sys.talkPending);
    S.elapsed++;
    const ph = currentPhase();
    const phaseChanged = !busy && S._lastPhase !== ph.id;
    if(phaseChanged){ S._lastPhase = ph.id; resetSubstateFor(ph.id); }
    let firedTick = false;
    if(S.sys.firedPending && S.sys.firedWait>0){
      S.sys.firedWait--;
      firedTick = true;
    }
    const hitEnd = !busy && S.elapsed >= TOTAL;
    if(hitEnd){ S.elapsed = TOTAL; S.running = false; enterEnd(); }
    renderHUD();
    if(phaseChanged || hitEnd || firedTick){ if(renderBody()) fitScreen(); }
  }, 1000);
}

function togglePause(){ S.running = !S.running; render(); }

function advanceNow(){
  const ph = currentPhase();
  const idx = PHASES.findIndex(p=>p.id===ph.id);
  const next = PHASES[idx+1];
  if(!next){ S.elapsed = TOTAL; S.running=false; enterEnd(); render(); return; }
  S.elapsed = next.at;
  S._lastPhase = next.id;
  resetSubstateFor(next.id);
  render();
  // Anuncio según el tipo de fase
  setTimeout(() => {
    if(next.id.includes('decision')) Anuncios?.decir?.('faseDecision');
    else if(next.id.includes('mini')) Anuncios?.decir?.('faseMiniJuego');
    else Anuncios?.decir?.('proximo');
  }, 300);
}
function finishNow(){
  S.elapsed = TOTAL;
  S.running = false;
  Anuncios?.decir?.('misionTerminada');
  enterEnd();
  render();
}

function goBack(){
  if(S.screen==='end'){
    const locked = S.launch && (S.launch.stage==='countdown' || (S.launch.stage==='resolved' && ['success','failure'].includes(S.launch.outcome)));
    if(locked) return;
    S.screen='mission';
    const entregaPh = PHASES[PHASES.length-1];
    S.elapsed = entregaPh.at;
    S._lastPhase = entregaPh.id;
    S.launch = null;
    S.running = true;
    render();
    return;
  }
  const ph = currentPhase();
  if(ph.id==='sistemas'){
    if(S.sys.firedPending || S.sys.deciding || S.sys.clearedPending) return;
    if(S.sys.idx>=S.participants.length && S.decision!=null){ S.decision=null; render(); return; }
    if(S.sys.q1!=null){ S.sys.q1=null; render(); return; }
    if(S.sys.miniDone){ S.sys.miniDone=false; S.sys.ttt=null; render(); return; }
    if(S.sys.idx>0){ S.sys.idx--; S.sys.miniDone=true; S.sys.ttt=null; render(); return; }
  }

  const idx = PHASES.findIndex(p=>p.id===ph.id);
  if(idx<=0){ S.screen='setup'; S.running=false; clearInterval(timerHandle); render(); return; }
  const prev = PHASES[idx-1];
  S.elapsed = prev.at;
  S._lastPhase = prev.id;
  resetSubstateFor(prev.id);
  if(prev.id==='sistemas'){ S.sys = {idx:S.participants.length-1, q1:null, miniDone:true, ttt:null, miniResult:null}; }
  render();
}

function tttInit(){ return {board:Array(9).fill(null), over:false, winner:null, winLine:null, botThinking:false}; }
function tttCheckWinner(board){
  const lines = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];
  for(const line of lines){
    const [a,b,c] = line;
    if(board[a] && board[a]===board[b] && board[a]===board[c]) return {winner:board[a], line:line};
  }
  if(board.every(c=>c)) return {winner:'draw', line:null};
  return null;
}
function tttSoundForOutcome(winner){
  if(winner==='X') Sound.win();
  else if(winner==='O') Sound.lose();
}
function tttTap(i){
  const t = S.sys.ttt;
  if(!t || t.over || t.board[i] || t.botThinking) return;
  t.board[i] = 'X';
  Sound.placeX();
  const w1 = tttCheckWinner(t.board);
  if(w1){ t.over = true; t.winner = w1.winner; t.winLine = w1.line; tttSoundForOutcome(w1.winner); render(); return; }
  t.botThinking = true;
  render();
  setTimeout(function(){
    const empties = t.board.map((v,idx)=>v?null:idx).filter(v=>v!==null);
    if(empties.length){
      const pick = empties[Math.floor(Math.random()*empties.length)];
      t.board[pick] = 'O';
    }
    Sound.placeO();
    const w2 = tttCheckWinner(t.board);
    t.botThinking = false;
    if(w2){ t.over = true; t.winner = w2.winner; t.winLine = w2.line; tttSoundForOutcome(w2.winner); }
    render();
  }, 700);
}
function tttRetry(){
  S.sys.ttt = tttInit();
  Anuncios?.decir?.('faseMiniJuego');
  render();
}
function tttContinue(){
  S.sys.miniResult = 'win';
  S.sys.miniDone = true;
  render();
}

function pickQ1(ans){
  S.sys.q1 = ans;
  if(ans==='YES'){
    showToast('Respuesta registrada: Habló en la sala', 'caution', 3000);
    S.sys.talkPending = true; render();
  }
  else {
    showToast('Respuesta registrada: Guardó silencio', 'critical', 3000);
    render();
  }
}
function continueAfterTalk(){
  S.sys.talkPending = false;
  finalizeParticipant('YES');
}
function pickQ2(ans){ finalizeParticipant(ans); }
function finalizeParticipant(q2){
  const p = S.participants[S.sys.idx];
  S._bitStore[p.cardId] = {q1:S.sys.q1, q2:q2};
  const admitted = (S.sys.q1==='YES' || q2==='YES');
  const saidInRoom = S.sys.q1==='YES';

  if(saidInRoom){
    const sysDef = SYSTEMS.find(s=>s.id===p.cardId);
    const hrs = DELAY_HOURS[p.cardId] || 0;
    S.fixedDelayHours += hrs;
    S.sys.fixName = sysDef ? sysDef.name : '';
    S.sys.fixHours = hrs;
  } else {
    S.sys.fixName = ''; S.sys.fixHours = 0;
  }

  S.sys.idx++; S.sys.q1=null; S.sys.miniDone=false; S.sys.ttt=null; S.sys.miniResult=null;

  if(!admitted){ render(); return; }

  S.sys.deciding = true;
  render();
  const reduced = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  setTimeout(function(){
    const sysDef = SYSTEMS.find(s=>s.id===p.cardId);
    const maxWeight = Math.max.apply(null, SYSTEMS.map(function(s){ return s.weight; }));
    const severity = sysDef ? sysDef.weight / maxWeight : 0;
    const fireProb = Math.min(0.85, Math.max(0.20, 0.40 + 0.40*severity));
    const fired = Math.random() < fireProb;
    p.credited = !fired;
    S.sys.deciding = false;
    const role = AVATARS[p.cardId] ? AVATARS[p.cardId].role : p.name;
    if(fired){
      Sound.fired();
      p.fired = true;
      S.sys.firedPending = true;
      S.sys.firedWait = 10;
      S.sys.firedName = role;
      S.sys.firedReason = FIRE_REASONS[Math.floor(Math.random()*FIRE_REASONS.length)];
    } else {
      Sound.cleared();
      S.sys.clearedPending = true;
      S.sys.clearedName = role;
    }
    render();
  }, reduced ? 0 : 1800);
}
function clearFired(){ S.sys.firedPending=false; S.sys.firedWait=0; render(); }
function clearCleared(){ S.sys.clearedPending=false; render(); }

function setDecision(d){ S.decision = d; if(d!=='COND'){ S.watchedSystems = []; } render(); }
function openBlackBox(){ if(S.launch) S.launch.boxOpen = true; render(); }

function setVerifText(i){
  const presets = VERIF_PRESETS[S.decision] || VERIF_PRESETS.GO;
  S.verifText = presets[i];
  render();
}

function submitPresetReflection(i){
  const wall = loadJSON('tmenos20_muro', []);
  wall.unshift(REFLECTION_PRESETS[i]);
  saveJSON('tmenos20_muro', wall);
  S.reflectionSubmitted++;
  render();
}

/* ---------- risk model: todo o nada ---------- */
function computeRisk(){
  const pool = S.selectedSystems;
  const contributions = [];
  let survival = 1;
  let allPublic = true;
  for(const sys of SYSTEMS){
    if(!pool.includes(sys.id)) continue;
    const rec = S._bitStore[sys.id];
    const isPublic = !!(rec && rec.q1==='YES');
    const privateOnly = !!(rec && rec.q1!=='YES' && rec.q2==='YES');
    if(!isPublic) allPublic = false;
    let frac = isPublic ? 0 : privateOnly ? HIDDEN_P[sys.id]/2 : HIDDEN_P[sys.id];
    if(S.decision==='COND' && S.watchedSystems && S.watchedSystems.includes(sys.id)){ frac = frac/3; }
    survival *= (1-frac);
    contributions.push({id:sys.id, name:sys.name, happened:sys.happened, contrib:HIDDEN_P[sys.id], hidden:!isPublic, privateOnly});
  }
  // Si a la sala le queda un solo sistema sin decir en voz alta, la misión está condenada:
  // no hay tirada de suerte que la salve. Solo con todo dicho en público entra en juego
  // el riesgo residual (nunca baja de 4%, ni la honestidad total es garantía).
  const risk = allPublic ? Math.max(4, Math.round((1-survival)*100)) : 100;
  contributions.sort((a,b)=>b.contrib-a.contrib);
  return {risk, contributions};
}
function disclosureCounts(){
  const pool = S.selectedSystems;
  let pub=0, priv=0, hidden=0;
  SYSTEMS.forEach(sys=>{
    const inPlay = pool.includes(sys.id);
    const rec = inPlay ? S._bitStore[sys.id] : null;
    if(!inPlay || !rec){ hidden++; return; }
    if(rec.q1==='YES') pub++;
    else if(rec.q2==='YES') priv++;
    else hidden++;
  });
  return {pub,priv,hidden};
}

function enterEnd(){
  S.screen = 'end';
  if(S.decision==null){ S.launch = {stage:'resolved', outcome:'none', ...computeRisk()}; registerRound(); return; }
  const {risk, contributions} = computeRisk();
  if(S.decision==='NOGO'){ S.launch = {stage:'resolved', outcome:'aborted', risk, contributions, boxOpen:false}; registerRound(); return; }
  S.launch = {stage:'ready', count:3, risk, contributions, outcome:null, cause:null, boxOpen:false};
  launchSequence();
}

function launchSequence(){
  if(!S.launch) return;
  S.view = 'mission';
  const reduced = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  S.launch.stage = 'countdown';
  S.launch.count = 3;
  render();
  if(reduced){ resolveLaunch(); return; }
  runCountdown();
}
function runCountdown(){
  Sound.tick();
  setTimeout(()=>{
    S.launch.count--;
    if(S.launch.count>0){ render(); runCountdown(); }
    else { resolveLaunch(); }
  }, 900);
}
function resolveLaunch(){
  const roll = Math.random()*100;
  const fail = roll < S.launch.risk;
  S.launch.stage = 'resolved';
  S.launch.outcome = fail ? 'failure' : 'success';
  if(fail) Sound.failure(); else Sound.success();
  if(fail){
    const hidden = S.launch.contributions.filter(c=>c.hidden).sort((a,b)=>b.contrib-a.contrib);
    S.launch.cause = hidden.length ? hidden[0].id : null;
  }
  registerRound();
  render();
}

function registerRound(){
  if(S.savedRound) return;
  const board = loadJSON('tmenos20_tablero', []);
  const d = disclosureCounts();
  board.push({
    sala: board.length+1, decision: S.decision, verifText: S.verifText,
    pub:d.pub, priv:d.priv, hidden:d.hidden,
    outcome: S.launch ? S.launch.outcome : null, risk: S.launch ? S.launch.risk : null,
    ts: Date.now(),
  });
  saveJSON('tmenos20_tablero', board);
  S.savedRound = true;
  render();
}

function setTableroDesde(v){ S.tableroDesde = v; render(); }
function setTableroHasta(v){ S.tableroHasta = v; render(); }
function clearTableroFiltro(){ S.tableroDesde = ''; S.tableroHasta = ''; render(); }

function newCrew(){ registerRound(); S.screen = 'setup'; S.nav = 'cajanegra'; clearInterval(timerHandle); render(); }

function jumpToStep(stepIdx){
  if(!S.running || S.nav!=='cajanegra' || S.screen==='setup') return;
  const n = S.participants.length;
  if(stepIdx < 0 || stepIdx >= n) return;
  S.sys.idx = stepIdx;
  S.sys.q1 = null;
  S.sys.miniDone = false;
  S.sys.ttt = null;
  S.sys.miniResult = null;
  S.sys.deciding = false;
  S.sys.firedPending = false;
  S.sys.clearedPending = false;
  S.decision = null;
  render();
}

function setCurrentStep(val){
  jumpToStep(parseInt(val));
}

function setCount(n){
  S.count = n;
  S.selectedSystems = (POOL_BY_COUNT[n] || []).slice();
  render();
}
function toggleSystemPick(id){
  const idx = S.selectedSystems.indexOf(id);
  if(idx>=0){ S.selectedSystems.splice(idx,1); }
  else {
    if(S.selectedSystems.length >= S.count) return;
    S.selectedSystems.push(id);
  }
  render();
}

function decisionLabel(d){ return d==='GO' ? 'GO' : d==='COND' ? 'GO CON CONDICIÓN' : d==='NOGO' ? 'NO GO' : 'SIN DECIDIR'; }
function decisionClass(d){ return d==='GO' ? 'go' : d==='COND' ? 'cond' : d==='NOGO' ? 'nogo' : 'dim'; }
function shipTag(r){
  if(r.decision==='NOGO') return '<span class="dot dim"></span>NO DESPEGÓ';
  if(r.outcome==='success') return '<span class="dot go"></span>LLEGÓ';
  if(r.outcome==='failure') return '<span class="dot nogo"></span>NO LLEGÓ';
  return '<span class="dot dim"></span>SIN DATO';
}

/* ---------- render helpers ---------- */

function eyebrow(text, center, colorVar){ return `<div class="eyebrow ${center?'outcome-eyebrow':''}" style="${colorVar?`--eyebrow-c:var(${colorVar})`:''}"><span class="beacon"></span>${text}</div>`; }
function panel(inner, extraClass, colorVar){ return `<div class="panel ${extraClass||''} ${colorVar?'panel-tint':''}" style="${colorVar?`--panel-accent:var(${colorVar})`:''}">${inner}</div>`; }
function cardField(label, body, colorVar){
  return `<div class="card-field" style="--fc:var(${colorVar})"><div class="card-field-label">${label}</div><div class="card-field-body">${body}</div></div>`;
}
function alertBanner(text){ return `<div class="alert-banner">${text}</div>`; }
function backRow(forwardHTML){
  return `<div class="row"><button class="ghost grow" onclick="goBack()">ATRÁS</button>${forwardHTML?`<div class="grow">${forwardHTML}</div>`:''}</div>`;
}
function toggleWatched(id){
  const idx = S.watchedSystems.indexOf(id);
  if(idx>=0){ S.watchedSystems.splice(idx,1); } else { S.watchedSystems.push(id); }
  render();
}
function systemsStrip(){
  const pool = S.selectedSystems;
  return `<div class="sysstrip">${SYSTEMS.map(sys=>{
    const inPlay = pool.includes(sys.id);
    const rec = inPlay ? S._bitStore[sys.id] : null;
    const cls = !inPlay ? 'dim' : (rec && rec.q1==='YES') ? 'go' : 'nogo';
    return `<div class="sysdot ${cls}">${esc(sys.name.slice(0,3))}</div>`;
  }).join('')}</div>`;
}
function blackBoxHTML(){
  const pool = S.selectedSystems;
  const lines = SYSTEMS.filter(s=>pool.includes(s.id)).map(s=>{
    const rec = S._bitStore[s.id];
    const said = !!(rec && rec.q1==='YES');
    const tag = said ? '<span style="color:var(--go)">[DICHO A TIEMPO]</span> ' : '';
    return `<span class="n">${s.id}.</span> ${tag}${esc(INFORME[s.id-1])}`;
  });
  return `<div class="telex">${lines.join('\n\n')}</div>`;
}
function prepBar(){
  const n = S.participants.length;
  const done = Math.min(S.sys.idx, n);
  const pct = Math.round(done/n*100);
  return `<div class="field-label" style="text-align:center">Preparación de la nave: ${done}/${n}</div>
    <div class="progress-track" style="margin:4px 0 2px"><div class="progress-fill" style="width:${pct}%"></div></div>`;
}
function rocketSVG(state){
  const tip = state==='success'?176:state==='countdown'?154:134;
  const outerTip = tip - 8;
  const coreTip = 122 + (tip-122)*0.55;
  return `<svg class="rocket state-${state}" viewBox="0 0 100 182" width="90" height="154" style="display:block;margin:12px auto">
    <defs>
      <linearGradient id="hullSheen-${state}" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#fff" stop-opacity=".10"/>
        <stop offset="42%" stop-color="#fff" stop-opacity="0"/>
        <stop offset="100%" stop-color="#000" stop-opacity=".14"/>
      </linearGradient>
    </defs>
    <ellipse class="smoke" cx="50" cy="130" rx="23" ry="7"></ellipse>
    <ellipse class="smoke" cx="36" cy="139" rx="14" ry="6"></ellipse>
    <ellipse class="smoke" cx="65" cy="137" rx="13" ry="5.5"></ellipse>
    <path class="flame-outer" d="M37,120 C32,134 29,148 50,${outerTip} C71,148 68,134 63,120 C58,126 42,126 37,120 Z"></path>
    <path class="flame" d="M42,122 C39,133 36,144 50,${tip} C64,144 61,133 58,122 C54,127 46,127 42,122 Z"></path>
    <path class="flame-core" d="M46,122 C45,129 43,136 50,${coreTip} C57,136 55,129 54,122 C52,124 48,124 46,122 Z"></path>
    <path class="fin" d="M36,90 C23,95 9,114 5,142 C13,145 22,143 28,137 C32,127 36,107 39,92 Z"></path>
    <path class="fin" d="M64,90 C77,95 91,114 95,142 C87,145 78,143 72,137 C68,127 64,107 61,92 Z"></path>
    <path class="hull" d="M50,4 C60,4 66,23 66,45 L66,118 C66,123 61,126 56,126 L44,126 C39,126 34,123 34,118 L34,45 C34,23 40,4 50,4 Z"></path>
    <path class="hull-sheen" fill="url(#hullSheen-${state})" d="M50,4 C60,4 66,23 66,45 L66,118 C66,123 61,126 56,126 L44,126 C39,126 34,123 34,118 L34,45 C34,23 40,4 50,4 Z"></path>
    <path class="nose-shade" d="M50,4 C57,4 62,17 64,33 L52,33 Z"></path>
    <path class="hull-seam" d="M34,68 L66,68 M34,99 L66,99"></path>
    ${state==='failure' ? '<line class="crack" x1="29" y1="58" x2="71" y2="97"></line><line class="crack" x1="71" y1="54" x2="37" y2="103"></line>' : ''}
    <circle class="window-ring" cx="50" cy="57" r="12.5"></circle>
    <circle class="window" cx="50" cy="57" r="9.5"></circle>
    <line class="window-cross" x1="50" y1="47.5" x2="50" y2="66.5"></line>
    <line class="window-cross" x1="40.5" y1="57" x2="59.5" y2="57"></line>
    <rect class="hatch" x="44" y="105" width="12" height="18" rx="3"></rect>
  </svg>`;
}

function cockpitSVG(){
  const stars = [
    [46,38,1.4],[92,26,1],[150,32,1.2],[338,30,1],[360,60,1.4],[372,120,1],
    [30,90,1],[36,150,1.3],[28,180,1],[350,170,1.2],[110,190,1],[70,20,1],
  ];
  return `<svg class="cockpit" viewBox="0 0 400 220" width="100%" height="auto" style="min-height:380px;max-width:100%" aria-hidden="true">
    <style>
      @keyframes orbit { 0%{transform:rotate(0deg)} 100%{transform:rotate(360deg)} }
      @keyframes orbitSlow { 0%{transform:rotate(0deg)} 100%{transform:rotate(360deg)} }
      @keyframes planetRotate { 0%{transform:rotate(0deg)} 100%{transform:rotate(360deg)} }
      .orbit-group { animation: orbit 20s linear infinite; transform-origin: 200px 110px; }
      .planet-g { animation: planetRotate 30s linear infinite; transform-origin: 200px 110px; }
    </style>
    <defs>
      <linearGradient id="rocketFire" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#ff6b00" stop-opacity=".8"/>
        <stop offset="50%" stop-color="#fbaf17" stop-opacity=".6"/>
        <stop offset="100%" stop-color="#ff6b00" stop-opacity="0"/>
      </linearGradient>
      <filter id="rocketGlow">
        <feGaussianBlur stdDeviation="1.2" result="coloredBlur"/>
        <feMerge>
          <feMergeNode in="coloredBlur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
      <filter id="energyRing">
        <feGaussianBlur stdDeviation="2" result="coloredBlur"/>
        <feMerge>
          <feMergeNode in="coloredBlur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
      <clipPath id="cpClip"><rect x="18" y="18" width="364" height="168" rx="16"></rect></clipPath>
      <style>
        @keyframes energyPulse { 0%,100%{opacity:.3;stroke-width:2} 50%{opacity:.8;stroke-width:3} }
        .energy-ring { animation: energyPulse 2.5s ease-in-out infinite; }
      </style>
    </defs>
    <rect class="cp-frame" x="4" y="4" width="392" height="196" rx="24"></rect>
    <g clip-path="url(#cpClip)">
      <rect x="18" y="18" width="364" height="168" fill="var(--bg)"></rect>
      ${stars.map(([x,y,r],i)=>`<circle class="cp-star${i%3===0?' dim':''}" cx="${x}" cy="${y}" r="${r}"></circle>`).join('')}

      <!-- Planeta en el centro -->
      <g transform="translate(200, 110)">
        <!-- Órbitas alrededor del planeta -->
        <circle cx="0" cy="0" r="42" fill="none" stroke="rgba(31,178,222,.15)" stroke-width="1" stroke-dasharray="2,2"/>
        <circle cx="0" cy="0" r="52" fill="none" stroke="rgba(251,175,23,.1)" stroke-width="1" stroke-dasharray="3,3"/>

        <!-- Planeta Tierra -->
        <defs>
          <radialGradient id="planetGlow">
            <stop offset="0%" stop-color="rgba(31,178,222,.4)"/>
            <stop offset="100%" stop-color="rgba(31,178,222,.1)"/>
          </radialGradient>
        </defs>

        <circle cx="0" cy="0" r="28" fill="#1a4d7a" stroke="rgba(31,178,222,.3)" stroke-width="1.5" filter="url(#energyRing)"/>
        <!-- Océanos -->
        <path d="M -20,-10 Q -15,-20 0,-22 Q 15,-20 20,-10 Q 18,0 15,10 Q 10,15 0,16 Q -10,15 -15,10 Q -18,0 -20,-10 Z" fill="rgba(15,178,222,.6)" opacity=".4"/>
        <!-- Continentes -->
        <ellipse cx="-8" cy="-8" rx="6" ry="4" fill="rgba(166,206,56,.5)" opacity=".5"/>
        <ellipse cx="10" cy="6" rx="5" ry="6" fill="rgba(166,206,56,.4)" opacity=".5"/>
        <!-- Brillo del planeta -->
        <circle cx="0" cy="0" r="28" fill="none" stroke="rgba(255,255,255,.2)" stroke-width="2" opacity=".6"/>

        <!-- Cohete en órbita -->
        <g class="orbit-group">
          <g transform="translate(0, -50)">
            <!-- Cohete en órbita con movimiento -->
            <path d="M 0,-12 L 3,-5 L 3,10 Q 3,14 0,15 Q -3,14 -3,10 L -3,-5 Z" fill="var(--accent-2)" filter="url(#rocketGlow)" stroke="rgba(31,178,222,.9)" stroke-width="1.5"/>
            <!-- Anillos de energía del cohete -->
            <circle cx="0" cy="0" r="18" fill="none" stroke="var(--go)" opacity=".3" stroke-width="1" filter="url(#energyRing)"/>
            <circle cx="0" cy="0" r="22" fill="none" stroke="var(--amber)" opacity=".2" stroke-width="0.8" filter="url(#energyRing)"/>
            <!-- Aletas -->
            <path d="M -3,4 L -10,11 L -3,9 Z" fill="var(--go)" opacity=".8"/>
            <path d="M 3,4 L 10,11 L 3,9 Z" fill="var(--go)" opacity=".8"/>
            <!-- Fuego -->
            <path d="M -1,14 Q -2,18 -1,22" fill="url(#rocketFire)" opacity=".7"/>
            <path d="M 1,14 Q 2,18 1,22" fill="url(#rocketFire)" opacity=".7"/>
          </g>
        </g>

        <!-- Satélite pequeño -->
        <g class="orbit-group" style="animation-duration:30s;animation-direction:reverse">
          <circle cx="0" cy="-38" r="2.5" fill="var(--amber)" opacity=".8" filter="url(#energyRing)"/>
        </g>
      </g>

      <g transform="translate(200, 65)">
        <!-- Imagen del cohete de referencia -->
        <image x="-65" y="-80" width="130" height="140" xlink:href="data:image/webp;base64," preserveAspectRatio="xMidYMid meet"/>

        <!-- Anillos de energía pulsantes alrededor -->
        <circle class="energy-ring" cx="0" cy="0" r="55" fill="none" stroke="rgba(100,200,255,.5)" opacity=".35" stroke-width="2.5" filter="url(#energyRing)"/>
        <circle class="energy-ring" cx="0" cy="0" r="68" fill="none" stroke="rgba(255,215,0,.4)" opacity=".3" stroke-width="2" filter="url(#energyRing)" style="animation-delay:.3s"/>
      </g>
    </g>
    <circle class="cp-rivet" cx="16" cy="16" r="3"></circle>
    <circle class="cp-rivet" cx="384" cy="16" r="3"></circle>
    <circle class="cp-rivet" cx="16" cy="196" r="3"></circle>
    <circle class="cp-rivet" cx="384" cy="196" r="3"></circle>
    <rect class="cp-panel" x="16" y="192" width="52" height="20" rx="3"></rect>
    <circle class="cp-led go blink" cx="27" cy="202" r="2.4"></circle>
    <circle class="cp-led warn" cx="42" cy="202" r="2.4"></circle>
    <circle class="cp-led go" cx="57" cy="202" r="2.4"></circle>
    <rect class="cp-panel" x="332" y="192" width="52" height="20" rx="3"></rect>
    <circle class="cp-led go" cx="343" cy="202" r="2.4"></circle>
    <circle class="cp-led go" cx="358" cy="202" r="2.4"></circle>
    <circle class="cp-led warn blink" cx="373" cy="202" r="2.4"></circle>
  </svg>`;
}

function renderHUD(){
  const hud = document.getElementById('hud');
  const topbar = document.getElementById('topbar');
  const devNav = document.getElementById('devNav');
  if(S.nav!=='cajanegra' || S.screen==='setup'){
    hud.innerHTML = '';
    topbar.innerHTML = '';
    devNav.innerHTML = '';
    return;
  }
  const ph = currentPhase();
  const idx = phaseIndex();
  const remain = TOTAL - S.elapsed;
  const crit = remain <= 90;
  const n = S.participants ? S.participants.length : 0;
  const stepOpts = Array.from({length:n}, (_,i) => `<option value="${i}" ${S.sys.idx===i?'selected':''}>${i+1}</option>`).join('');

  // Topbar modular (3 zonas)
  topbar.innerHTML = `
    <div style="display:flex;align-items:center;gap:var(--space-md);flex:1;min-width:0">
      <div class="brand-mark" style="width:32px;height:32px;border-radius:50%;background:var(--panel-2);border:1px solid var(--accent-2);display:flex;align-items:center;justify-content:center;flex:0 0 auto">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="var(--accent-2)" style="opacity:.9">
          <circle cx="12" cy="12" r="8" fill="none" stroke="var(--accent-2)" stroke-width="1.5"/>
          <path d="M12 6v12M6 12h12" stroke="var(--accent-2)" stroke-width="1.5" fill="none"/>
        </svg>
      </div>
      <div style="font-family:var(--mono);font-size:11px;letter-spacing:.08em;color:var(--ink-faint);text-transform:uppercase">METRO POLI LAB</div>
    </div>
    <div style="display:flex;flex-direction:column;gap:3px;flex:1;min-width:0;text-align:center">
      <div style="font-family:var(--mono);font-size:11px;color:var(--ink-faint);letter-spacing:.05em">${S.screen==='end'?'SALA ENTREGADA':ph.code}</div>
      <div style="font-family:var(--mono);font-size:14px;color:var(--ink);letter-spacing:.01em">${S.screen==='end'?'Cuenta regresiva finalizada':ph.label}</div>
    </div>
    <div style="display:flex;align-items:center;gap:var(--space-md);flex:1;justify-content:flex-end">
      <div class="clock ${crit?'crit':''}" style="font-size:48px;font-weight:700;font-family:var(--mono);color:var(--amber);text-shadow:0 0 20px rgba(255,176,32,.3)">${fmt(remain)}</div>
      <button class="pausebtn" onclick="togglePause()" ${S.screen==='end'?'style=visibility:hidden':''}>${S.running?'PAUSAR':'SEGUIR'}</button>
    </div>
  `;

  hud.innerHTML = `
    <div class="progress-track"><div class="progress-fill" style="width:${(S.elapsed/TOTAL*100).toFixed(2)}%"></div></div>
  `;
  devNav.innerHTML = `
    <div class="dev-navigator">
      <div class="dev-navigator-label">PASO ${S.sys.idx+1} DE ${n}</div>
      <div class="dev-navigator-controls">
        <button class="dev-nav-btn" onclick="jumpToStep(Math.max(0,S.sys.idx-1))">◀</button>
        <select class="dev-nav-select" onchange="setCurrentStep(this.value)">${stepOpts}</select>
        <button class="dev-nav-btn" onclick="jumpToStep(Math.min(${n}-1,S.sys.idx+1))">▶</button>
      </div>
    </div>
  `;
}

function renderQueueVisual(){
  const n = S.participants.length;
  const currentIdx = S.sys.idx;
  let html = '<div style="display:flex;align-items:flex-end;justify-content:center;gap:12px;flex-wrap:wrap;margin:16px 0">';

  for(let i = 0; i < n; i++){
    const p = S.participants[i];
    const isDone = i < currentIdx;
    const isCurrent = i === currentIdx;
    const isNext = i === currentIdx + 1 || i === currentIdx + 2;

    if(isCurrent){
      html += `
        <div style="display:flex;flex-direction:column;align-items:center;gap:6px;animation:pulse 2s ease-in-out infinite">
          <div style="position:relative;width:80px;height:80px;border:2px solid var(--accent-2);border-radius:12px;padding:6px;background:var(--accent-dim);box-shadow:0 0 20px var(--accent-2)">
            ${avatarSVG(p.cardId, 68)}
          </div>
          <div style="font-family:var(--mono);font-size:12px;font-weight:700;color:var(--accent-2);text-align:center">${esc(p.name)}</div>
          <div style="font-family:var(--mono);font-size:10px;color:var(--ink-faint);text-align:center">ACTUAL</div>
        </div>
      `;
    } else if(isNext){
      html += `
        <div style="display:flex;flex-direction:column;align-items:center;gap:4px;opacity:.6">
          <div style="position:relative;width:60px;height:60px;border:1px solid var(--border);border-radius:10px;padding:4px">
            ${avatarSVG(p.cardId, 52)}
          </div>
          <div style="font-family:var(--mono);font-size:11px;color:var(--ink-faint);text-align:center">${esc(p.name)}</div>
        </div>
      `;
    } else if(isDone){
      html += `
        <div style="display:flex;flex-direction:column;align-items:center;gap:4px;opacity:.3">
          <div style="width:40px;height:40px;border-radius:8px;padding:2px;text-decoration:line-through">
            ${avatarSVG(p.cardId, 36)}
          </div>
          <div style="font-family:var(--mono);font-size:9px;color:var(--ink-faint);text-decoration:line-through">${esc(p.name)}</div>
        </div>
      `;
    }
  }

  html += '</div>';
  return html;
}

function trikiInfoIcon(){
  return `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 3 20 7.5v9L12 21 4 16.5v-9z"/>
    <path d="M9.6 9.3a2.5 2.5 0 0 1 4.9.5c0 1.7-2.4 1.9-2.4 3.5"/>
    <circle cx="12" cy="16.3" r=".9" fill="currentColor" stroke="none"/>
  </svg>`;
}
function trikiDiceIcon(){
  return `<svg viewBox="0 0 24 24" width="20" height="20">
    <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.7"/>
    <circle cx="8" cy="8" r="1.7" fill="var(--accent-2)"/>
    <circle cx="16" cy="8" r="1.7" fill="var(--amber)"/>
    <circle cx="12" cy="12" r="1.7" fill="var(--ink)"/>
    <circle cx="8" cy="16" r="1.7" fill="var(--rose)"/>
    <circle cx="16" cy="16" r="1.7" fill="var(--go)"/>
  </svg>`;
}
function navIcon(name, size){
  const icons = {
    home:'<path d="M4 11.5 12 5l8 6.5"/><path d="M6 10v9h12v-9"/><path d="M10 19v-5h4v5"/>',
    target:'<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3.2"/>',
    team:'<circle cx="9" cy="9" r="3.2"/><circle cx="16" cy="10.5" r="2.6"/><path d="M3.5 19c.6-3.4 2.9-5.2 5.5-5.2s4.9 1.8 5.5 5.2"/><path d="M14.8 14c2.1.2 3.8 1.8 4.2 5"/>',
    compass:'<circle cx="12" cy="12" r="8.2"/><path d="M14.8 9.2 13 13l-3.8 1.8L11 11z"/>',
    folder:'<path d="M3.5 6.5h5l2 2h10v9.5h-17z"/>',
    gear:'<circle cx="12" cy="12" r="3"/><path d="M12 4v2.2M12 17.8V20M4 12h2.2M17.8 12H20M6.5 6.5l1.6 1.6M15.9 15.9l1.6 1.6M6.5 17.5l1.6-1.6M15.9 8.1l1.6-1.6"/>',
    bank:'<path d="M3 10.5 12 4l9 6.5"/><path d="M4.5 10.5V20M9 10.5V20M15 10.5V20M19.5 10.5V20"/><path d="M3 20h18"/>',
    speaker:'<path d="M4 9v6h4l5 4V5L8 9z"/><path d="M16.3 8.7a5 5 0 0 1 0 6.6"/><path d="M19 6.2a8.5 8.5 0 0 1 0 11.6"/>',
    lock:'<rect x="5.5" y="10.5" width="13" height="9" rx="1.6"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>',
    userx:'<circle cx="10" cy="8.5" r="3.2"/><path d="M4 19c.5-3.2 2.8-5 6-5s5.5 1.8 6 5"/><path d="M16.5 8.5l4 4M20.5 8.5l-4 4"/>',
    bars:'<rect x="5" y="13" width="3" height="6" rx="0.8"/><rect x="10.5" y="9" width="3" height="10" rx="0.8"/><rect x="16" y="5" width="3" height="14" rx="0.8"/>',
  };
  return `<svg viewBox="0 0 24 24" width="${size||18}" height="${size||18}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${icons[name]||''}</svg>`;
}
