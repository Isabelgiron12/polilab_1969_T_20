260132 c0,0.2489929-0.2000122,0.4749756-0.4760132,0.4749756h-4.3519897v15.3560181c0,0.2489929-0.2249756,0.4750061-0.4749756,0.4750061 h-0.9500122c-0.25,0-0.4749756-0.2260132-0.4749756-0.4750061V307.9281921z"/> <path class="pm0" d="M503.9963684,323.1085815l7.6029663-16.8320007c0.0750122-0.1489868,0.2000122-0.2739868,0.4250183-0.2739868 h0.25c0.2260132,0,0.3500366,0.125,0.4250488,0.2739868l7.5529785,16.8320007 c0.1499634,0.3250122-0.0490112,0.651001-0.4249878,0.651001h-1c-0.2250366,0-0.375-0.151001-0.4260254-0.2749939 l-1.8499756-4.1279907h-8.8790588l-1.8250122,4.1279907c-0.0499878,0.1239929-0.1999512,0.2749939-0.4259644,0.2749939h-1 C504.0463562,323.7595825,503.846344,323.4335938,503.9963684,323.1085815 M515.8764038,317.8065796 c-1.2260132-2.7259827-2.4260254-5.4769897-3.6520386-8.2029724h-0.2000122l-3.6510315,8.2029724H515.8764038z"/> <path class="pm0" d="M526.4859009,306.7268066c0-0.2489929,0.2009888-0.4750061,0.4749756-0.4750061h6.4780273 c3.0009766,0,5.4519653,2.3520203,5.4519653,5.3270264c0,2.3019714-1.526001,4.2279968-3.7019653,5.1019897l3.4269409,6.3540039 c0.1750488,0.3249817,0,0.723999-0.4249878,0.723999h-1.2749634c-0.2260132,0-0.3510132-0.1239929-0.401001-0.2250061 l-3.3259888-6.6270142h-4.7770386v6.3770142c0,0.25-0.2249756,0.4750061-0.4749756,0.4750061h-0.9760132 c-0.2739868,0-0.4749756-0.2250061-0.4749756-0.4750061V306.7268066z M533.3139038,315.2557983 c1.9259644,0,3.6019897-1.6009827,3.6019897-3.6509705c0-1.901001-1.6760254-3.5270081-3.6019897-3.5270081h-4.8520508v7.1779785 H533.3139038z"/> <path class="pm0" d="M546.5248413,306.7269897c0-0.25,0.2249756-0.4749756,0.4759521-0.4749756h1 c0.25,0,0.4750366,0.2249756,0.4750366,0.4749756v16.5570068c0,0.25-0.2250366,0.4750061-0.4750366,0.4750061h-1 c-0.2509766,0-0.4759521-0.2250061-0.4759521-0.4750061V306.7269897z"/> <path class="pm0" d="M554.6813965,323.1085815l7.6029663-16.8320007c0.0750122-0.1489868,0.2000122-0.2739868,0.4249878-0.2739868 h0.25c0.2260132,0,0.3500366,0.125,0.4250488,0.2739868l7.5529785,16.8320007 c0.1499634,0.3250122-0.0490112,0.651001-0.4249878,0.651001h-1c-0.2250366,0-0.3760376-0.151001-0.4260254-0.2749939 l-1.8499756-4.1279907h-8.8790283l-1.8250122,4.1279907c-0.0499878,0.1239929-0.1999512,0.2749939-0.4259644,0.2749939h-1 C554.7313843,323.7595825,554.5313721,323.4335938,554.6813965,323.1085815 M566.5614014,317.8065796 c-1.2260132-2.7259827-2.4260254-5.4769897-3.6520386-8.2029724h-0.2000122l-3.651001,8.2029724H566.5614014z"/></g>`;
function poliMark(heightPx, extraClass){
  return `<img class="poli-mark ${extraClass||''}" src="logo.webp" style="height:${heightPx}px;width:auto" role="img" aria-label="METROPOLILab" />`;
}
function orbitGraphic(){
  return `<svg viewBox="0 0 120 120">
    <defs>
      <radialGradient id="orbitPlanet" cx="40%" cy="36%" r="65%">
        <stop offset="0%" stop-color="#e8f4ff"/>
        <stop offset="35%" stop-color="#1fb2de"/>
        <stop offset="70%" stop-color="#0e7a9e"/>
        <stop offset="100%" stop-color="#051428"/>
      </radialGradient>
      <filter id="planetGlow">
        <feGaussianBlur stdDeviation="2" result="coloredBlur"/>
        <feMerge>
          <feMergeNode in="coloredBlur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
    </defs>
    <g class="orbit-spin">
      <ellipse cx="60" cy="60" rx="48" ry="12" fill="none" stroke="var(--accent-2)" stroke-width="1" opacity=".2" transform="rotate(-22 60 60)"/>
      <ellipse cx="60" cy="60" rx="56" ry="14" fill="none" stroke="var(--accent-2)" stroke-width="2.5" opacity=".6" transform="rotate(-22 60 60)" filter="drop-shadow(0 0 6px rgba(31,178,222,.4))"/>
      <ellipse cx="60" cy="60" rx="48" ry="11" fill="none" stroke="var(--accent-2)" stroke-width="1" opacity=".15" transform="rotate(-22 60 60) translateY(1)"/>
    </g>
    <circle cx="60" cy="60" r="26" fill="url(#orbitPlanet)" filter="url(#planetGlow)"/>
    <circle cx="60" cy="60" r="26" fill="none" stroke="rgba(255,255,255,.15)" stroke-width="1"/>
    <circle cx="45" cy="48" r="4" fill="rgba(255,255,255,.4)"/>
    <circle cx="20" cy="20" r="2" fill="var(--amber)" opacity=".8"/>
    <circle cx="104" cy="28" r="1.6" fill="var(--rose)" opacity=".7"/>
    <circle cx="10" cy="90" r="1.6" fill="var(--go)" opacity=".8"/>
    <circle cx="108" cy="96" r="2" fill="var(--violet)" opacity=".7"/>
  </svg>`;
}
const NAV_ITEMS = [
  {key:'inicio', label:'Inicio', icon:'home', c:'--accent-2', cd:'--accent-dim'},
  {key:'cajanegra', label:'Caja Negra', icon:'target', c:'--amber', cd:'--amber-dim'},
  {key:'equipo', label:'Equipo', icon:'team', c:'--rose', cd:'--rose-dim'},
  {key:'mision', label:'Misión', icon:'compass', c:'--violet', cd:'--violet-dim'},
  {key:'recursos', label:'Recursos', icon:'folder', c:'--go', cd:'--go-dim'},
  {key:'configuracion', label:'Configuración', icon:'gear', c:'--ink-dim', cd:'--panel-2'},
];
function setNav(n){ S.nav = n; render(); }
let _lastTopbarKey = null;
function renderTopbar(){
  const key = Sound.isEnabled()?'on':'off';
  if(key===_lastTopbarKey) return;
  _lastTopbarKey = key;
  const el = document.getElementById('topbar');
  el.innerHTML = `
    <div class="topbar-brand">
      ${poliMark(38)}
    </div>
    <div style="display:flex;align-items:center;gap:12px">
      <span class="sound-ic">${navIcon('speaker')}</span>
      <label class="switch">
        <input type="checkbox" ${Sound.isEnabled()?'checked':''} onchange="toggleSound()">
        <span class="switch-track"><span class="switch-thumb"></span></span>
        <span>SONIDO ${Sound.isEnabled()?'ON':'OFF'}</span>
      </label>
    </div>
  `;
}
let _lastSidebarKey = null;
function renderSidebar(){
  if(S.nav===_lastSidebarKey) return;
  _lastSidebarKey = S.nav;
  const el = document.getElementById('sidebar');
  el.innerHTML = NAV_ITEMS.map(it=>`
    <button class="nav-item ${S.nav===it.key?'active':''}" style="--nav-c:var(${it.c});--nav-cd:var(${it.cd})" onclick="setNav('${it.key}')">
      <span class="nav-ic">${navIcon(it.icon)}</span>${esc(it.label)}
    </button>
  `).join('');
}

function advanceIntro(){ S.introStep = (S.introStep||0) + 1; render(); }
function renderInicio(){
  const introStep = S.introStep||0;
  if(introStep===0){
    return `
      <div class="inicio-columns">
        <div class="area-crumb breadcrumb"><b>SALA DE CONTROL</b><span class="sep">›</span>CAJA NEGRA</div>
        <div class="area-text">
          <h1 class="inicio-title">POLILab</h1>
          <div class="inicio-subtitle">Laboratorio virtual de competencias</div>
          <p class="lede">POLILab es el laboratorio virtual de competencias del Politécnico Grancolombiano. Un espacio innovador que conecta el aprendizaje con las necesidades reales de desarrollo de nuestros colaboradores.</p>
          <p>Aquí fortalecemos las habilidades de nuestra comunidad para que enfrenten con éxito los retos del presente y del futuro.</p>
          ${panel(`
            <div class="creado-panel">
              <div class="creado-ic">${navIcon('team')}</div>
              <div class="creado-body">
                <div class="field-label">Creado por</div>
                <div class="creado-name">Escuela de Psicología, Talento Humano y Sociedad</div>
                <div class="creado-name">Grupo de investigación CVSSL</div>
                <div class="creado-year">Girón-Madroñero (2026)</div>
              </div>
              <div class="creado-bank">${navIcon('bank')}</div>
            </div>
          `)}
          <button class="primary" onclick="advanceIntro()">CONTINUAR →</button>
        </div>
        <div class="area-showcase">
          <div class="showcase-card">
            ${poliMark(64)}
            <div class="orbit-wrap">${orbitGraphic()}</div>
            <div class="showcase-tags"><span style="color:var(--accent-2)">APRENDER</span><span class="sep">•</span><span style="color:var(--amber)">COLABORAR</span><span class="sep">•</span><span style="color:var(--rose)">TRANSFORMAR</span></div>
          </div>
        </div>
      </div>
    `;
  }
  if(introStep===1){
    return `
      ${eyebrow('Sala de control', true, '--accent-2')}
      <h2 style="text-align:center">Faltan veinte minutos</h2>
      ${panel(`<p style="text-align:center;color:var(--ink);font-size:16.5px">Ustedes son la tripulación de esta nave. Cada uno controla un sistema distinto, y sin él, la nave no despega. Nadie más en la sala sabe lo que tú sabes sobre el tuyo.</p>`, '', '--accent-2')}
      <button class="primary" onclick="advanceIntro()">SEGUIR →</button>
    `;
  }
  return `
    ${eyebrow('Sala de control', true, '--amber')}
    <h2 style="text-align:center">La decisión es de todos</h2>
    ${panel(`<p style="text-align:center;color:var(--ink);font-size:16.5px">En los próximos veinte minutos van a tomar decisiones: algunas cada uno por su cuenta, en silencio; otras, la sala completa, en voz alta. No hay una jugada correcta preparada de antemano. El reloj corre solo, y no se detiene.</p>`, '', '--amber')}
    <button class="primary" onclick="setNav('cajanegra')">SEGUIR →</button>
  `;
}

function renderSetup(){
  return `
    ${eyebrow('Juego de sala de control', false, '--amber')}
    <h1>Caja Negra</h1>
    <div style="text-align:center;margin:8px 0 2px">
      <div class="field-label">Objetivo de la misión</div>
      <div style="font-family:var(--mono);font-weight:700;font-size:21px;color:var(--amber);line-height:1.3;margin-top:6px;text-shadow:0 0 18px rgba(255,176,32,.3)">LLEVAR LA NAVE AL ESPACIO EN 20 MINUTOS</div>
      <div style="font-family:var(--mono);font-weight:700;font-size:14px;color:var(--ink);line-height:1.4;margin-top:8px">Y QUE TODO EL EQUIPO LLEGUE HASTA EL FINAL</div>
    </div>
    <p class="lede" style="text-align:center">Faltan veinte minutos para el lanzamiento.</p>

    <div class="setup-columns">
      <div class="area-cockpit">${cockpitSVG()}</div>

      ${panel(`
        <div style="text-align:center">
          <div class="field-label">Tu rol</div>
          <div style="font-size:17px;color:var(--ink);font-weight:700;line-height:1.5;margin-top:6px">Cada uno controla un sistema de la nave.</div>
          <div style="font-size:14.5px;color:var(--ink-dim);margin-top:5px">Nadie sabe cómo le fue a los demás. Si te despiden, pierdes el juego.</div>
        </div>
      `, 'notice area-role')}

      ${panel(`
        <div class="field-label" style="margin-bottom:9px">¿Cuántos juegan?</div>
        <div class="seg">
          ${[2,3,4,5,6].map(n=>`<div class="seg-opt ${S.count===n?'active':''}" onclick="setCount(${n})">${n}</div>`).join('')}
        </div>
      `, 'area-count')}

      ${panel(`
        <div class="field-label" style="text-align:center;margin-bottom:4px">La tripulación de hoy (${S.selectedSystems.length}/${S.count})</div>
        <div class="donow" style="text-align:center;font-size:14px;margin-bottom:10px">▸ Toca para elegir quién forma parte del equipo.</div>
        <div class="roster-grid">
          ${SYSTEMS.map(sys=>{
            const picked = S.selectedSystems.includes(sys.id);
            return `
            <div class="roster-card ${picked?'picked':''}" onclick="toggleSystemPick(${sys.id})">
              ${avatarSVG(sys.id, 76, picked?'':'dim')}
              <div class="role">${esc(AVATARS[sys.id].role)}</div>
            </div>
          `;}).join('')}
        </div>
        <div class="footer-note" style="margin-top:10px">El sistema de cada quien se asigna al azar entre los elegidos.</div>
      `, 'area-roster')}
    </div>

    <button class="primary" onclick="startMission()" ${S.selectedSystems.length!==S.count?'disabled':''}>${S.selectedSystems.length!==S.count?'ELIGE '+S.count+' TRIPULANTES':'INICIAR CUENTA REGRESIVA'}</button>
    <div class="footer-note">La cuenta regresiva corre sola, sin pausas.<br>Cuando llegue a cero, se decide si la nave despega.</div>
  `;
}

function renderLectura(){
  return `
    ${eyebrow(currentPhase().code, false, '--amber')}
    <h2>Lectura de protocolo</h2>
    <div class="donow">▸ Uno de ustedes lee esto en voz alta. Los demás escuchan.</div>
    ${panel(`
      <ol class="protocol-list">
        <li><span><b>Cada uno responde por un sistema necesario para la misión.</b> Sin él, la nave no funciona. Tu carta no se muestra ni se lee en voz alta: solo se sabe lo que tú decidas contar.</span></li>
        <li><span>En la discusión, todos hablan libre. Nadie está obligado a hablar.</span></li>
        <li><span>La sala manda <b>una sola verificación</b>, firmada por todos.</span></li>
        <li><span>En el momento, <b>nadie sabe cuál es la jugada correcta</b>. Eso se sabrá después.</span></li>
      </ol>
    `)}
    ${backRow(`<button class="primary" onclick="advanceNow()">Ya la leímos, seguir →</button>`)}
  `;
}

function renderTalkToTeam(){
  return `
    ${eyebrow(currentPhase().code, true, '--accent-2')}
    <h2 style="text-align:center">Momento de hablar con el equipo</h2>
    ${panel(`
      <div style="text-align:center;padding:6px 0">
        <div class="donow">Habla con tu equipo en sala y cuéntales lo sucedido.</div>
        <p style="margin-top:10px">Tómense el tiempo que necesiten para conversarlo antes de seguir.</p>
      </div>
    `, '', '--accent-2')}
    <button class="primary" onclick="continueAfterTalk()">SEGUIR →</button>
  `;
}
function renderDeciding(){
  return `
    ${eyebrow(currentPhase().code, true)}
    <h2 style="text-align:center">Tomando decisión sobre la situación</h2>
    ${panel(`
      <div style="text-align:center;padding:16px 0">
        <div class="spinner"></div>
        <p style="margin-top:16px;color:var(--ink-dim)">Los directivos están evaluando el caso.</p>
      </div>
    `)}
  `;
}
function renderCleared(){
  return `
    ${eyebrow(currentPhase().code, true)}
    <h2 style="text-align:center">Caso cerrado</h2>
    ${panel(`
      <p style="text-align:center;color:var(--ink)">Los directivos revisaron el caso de ${esc(S.sys.clearedName)}.</p>
      <p style="text-align:center;margin-top:8px;color:var(--go);font-weight:700">Sigue en el equipo.</p>
    `, 'flash-go')}
    ${S.sys.fixName ? panel(`
      <p style="text-align:center;color:var(--ink)">Como se dijo en voz alta, ya están arreglando <b>${esc(S.sys.fixName)}</b>.</p>
      <p style="text-align:center;margin-top:6px;color:var(--amber)">Retraso: +${esc(formatDuration(S.sys.fixHours))}.</p>
    `) : ''}
    <button class="primary" onclick="clearCleared()">CONTINUAR</button>
  `;
}
function renderFiredWait(){
  const done = S.sys.firedWait<=0;
  return `
    ${eyebrow(currentPhase().code)}
    <h2 style="text-align:center">Anuncio de la dirección</h2>
    ${panel(`
      <p style="text-align:center;color:var(--ink)">Los directivos llaman al equipo para anunciar:</p>
      <p style="color:var(--nogo);font-weight:700;text-align:center;margin-top:8px">"Se ha tomado la decisión de despedir a ${esc(S.sys.firedName)} por ${esc(S.sys.firedReason)}. Continúen con la misión."</p>
      <p style="text-align:center;margin-top:10px;color:var(--ink-dim)">${esc(S.sys.firedName)} pierde el juego.</p>
    `, 'flash-nogo')}
    ${S.sys.fixName ? panel(`
      <p style="text-align:center;color:var(--ink)">Aun así, como se dijo en voz alta, el equipo ya está arreglando <b>${esc(S.sys.fixName)}</b>.</p>
      <p style="text-align:center;margin-top:6px;color:var(--amber)">Retraso: +${esc(formatDuration(S.sys.fixHours))}.</p>
    `) : ''}
    ${panel(`
      <div class="field-label" style="text-align:center">${done?'Reemplazo listo':'Esperar 10 segundos para buscar el reemplazo'}</div>
      <div class="stat-num nogo lg" style="text-align:center;display:block;margin-top:8px">${done?'00':String(S.sys.firedWait).padStart(2,'0')}s</div>
    `)}
    <button class="primary" onclick="clearFired()" ${done?'':'disabled style="visibility:hidden"'}>CONTINUAR</button>
  `;
}

function renderSistemas(){
  const n = S.participants.length;
  if(S.sys.deciding){ return renderDeciding(); }
  if(S.sys.firedPending){ return renderFiredWait(); }
  if(S.sys.clearedPending){ return renderCleared(); }
  if(S.sys.talkPending){ return renderTalkToTeam(); }
  if(S.sys.idx >= n){
    const confirmados = S.selectedSystems.filter(id=>{ const r=S._bitStore[id]; return r && r.q1==='YES'; }).length;
    return `
      ${eyebrow(currentPhase().code)}
      <h2>La nave está lista. Decidan ahora.</h2>
      <p>Cada quien decidió a solas. Nadie vio la carta de nadie más. Con todo lo que se dijo en la sala: ¿envían la nave?</p>
      <div class="stack" style="gap:16px;margin-top:24px">
        ${prepBar()}
        <div class="row" style="gap:12px;flex-direction:column">
          <button class="primary go" onclick="confirmLaunchDecision()" style="font-size:18px;padding:20px 24px">ENVIAR CON NOVEDADES →</button>
          <button class="ghost" onclick="decisionNOGO()" style="font-size:18px;padding:20px 24px;color:var(--nogo);border-color:var(--nogo)">NO ENVIAR</button>
        </div>
        <div class="panel" style="text-align:center">
          <div class="field-label" style="margin-bottom:8px">Estado de sistemas</div>
          <div class="folded-row" style="justify-content:center">${S.participants.map(pp=>`<div class="fold${pp.fired?' fired':''}">${navIcon(pp.fired?'userx':'lock',16)}<span>${pp.fired?'DESPEDIDO':'CERRADO'}</span></div>`).join('')}</div>
          <div class="footer-note" style="margin-top:12px">▸ ${confirmados} de ${S.selectedSystems.length} confirmados. ${S.fixedDelayHours>0 ? `Retraso: <b style="color:var(--amber)">${esc(formatDuration(S.fixedDelayHours))}</b>` : 'Sin retrasos asumidos.'}</div>
        </div>
      </div>
      ${backRow()}
    `;
  }
  const p = S.participants[S.sys.idx];
  const sys = SYSTEMS.find(s=>s.id===p.cardId);
  if(!S.sys.miniDone){
    if(!S.sys.ttt) S.sys.ttt = tttInit();
    const t = S.sys.ttt;
    return `
      ${eyebrow(currentPhase().code+' · sistema '+sys.id+' de 6')}
      <h2>Pásale el dispositivo a</h2>
      <div class="sistemas-columns">
        <div class="area-turn">
          <div style="text-align:center">
            ${avatarSVG(sys.id, 76)}
            <div class="turn-name" style="margin-top:6px">${esc(p.name)}</div>
            <div class="field-label" style="margin-top:2px">${esc(AVATARS[sys.id].role)}</div>
          </div>
          ${prepBar()}
          ${panel(`
            <div class="triki-intro">
              <div class="triki-intro-ic">${trikiInfoIcon()}</div>
              <div>
                <div class="field-label" style="color:var(--amber)">TRIKI</div>
                <div style="color:var(--ink);font-weight:600;margin-top:2px">Prueba de acceso a tu sistema</div>
                <div class="footer-note" style="text-align:left;margin-top:6px">▸ Gana el triki para revisar tu sistema.</div>
              </div>
            </div>
          `, '', '--amber')}
        </div>
        <div class="area-triki">
          ${panel(`
            <div class="triki-head">
              <div class="triki-head-ic">${trikiDiceIcon()}</div>
              <div class="triki-head-title grow">TRIKI</div>
            </div>
            <div class="rainbow-bar"></div>
            <div class="donow" style="text-align:center;margin-top:8px">Selecciona una casilla y completa el triki.</div>
            <div class="footer-note" style="margin-top:2px">Encuentra la combinación correcta.</div>
            <div class="ttt-grid">
              ${t.board.map((v,i)=>{
                const win = t.winLine && t.winLine.includes(i);
                const cls = win ? (t.winner==='X'?'win-x':'win-o') : (v?'filled':'');
                const mark = v==='X' ? avatarSVG(sys.id, 44) : v==='O' ? '<span class="dot nogo" style="width:24px;height:24px"></span>' : '';
                return `<button class="ttt-cell ${cls}" onclick="tttTap(${i})" ${(v||t.over||t.botThinking)?'disabled':''}>${mark}</button>`;
              }).join('')}
            </div>
            <div class="ttt-status">
              ${t.botThinking ? `<div class="footer-note">La máquina está pensando…</div>` : ''}
              ${t.over ? `
                <div class="footer-note" style="font-weight:700;color:${t.winner==='X'?'var(--go)':t.winner==='draw'?'var(--ink)':'var(--nogo)'}">${t.winner==='X'?'GANASTE EL TRIKI':t.winner==='draw'?'EMPATE, VUELVE A INTENTAR':'PERDISTE EL TRIKI'}</div>
                ${t.winner==='X'
                  ? `<button class="primary" onclick="tttContinue()">CONTINUAR</button>`
                  : `<button class="primary" onclick="tttRetry()">REINTENTAR</button>`}
              ` : ''}
            </div>
          `)}
        </div>
      </div>
      ${backRow()}
    `;
  }
  if(S.sys.q1==null){
    return `
      ${eyebrow(currentPhase().code+' · sistema '+sys.id+' de 6')}
      <div class="sistemas-columns">
        <div class="area-turn">
          ${panel(`
            <div class="card-system">
              <div class="name">${esc(sys.name)}</div>
              ${cardField('Habilidad', esc(AVATARS[sys.id].ability), '--rose')}
              ${cardField('De qué respondes', esc(sys.does), '--amber')}
              ${cardField('Lo que pasó, y solo tú lo sabes', esc(sys.happened), '--go')}
              ${cardField('Lo que hay detrás', esc(sys.costs), '--go')}
              ${cardField('Cuánto retrasa arreglarlo', esc(formatDuration(DELAY_HOURS[sys.id])), '--accent-2')}
              ${cardField('⚠ Advertencia crítica', 'Decirlo en voz alta puede costarte el puesto. Nadie te va a explicar por qué, solo que ya no estás. Si te quedas callado, mañana sigues teniendo este trabajo, y nadie te va a preguntar por qué no dijiste nada. Si te vas, el juego se acaba aquí para ti.', '--nogo')}
            </div>
          `)}
        </div>
        <div class="area-triki">
          ${panel(`
            <div class="field-label" style="text-align:center">Pásale el dispositivo a</div>
            <div style="text-align:center;margin-top:10px">
              ${avatarSVG(sys.id, 64)}
              <div class="turn-name" style="margin-top:6px">${esc(p.name)}</div>
              <div class="field-label" style="margin-top:2px">${esc(AVATARS[sys.id].role)}</div>
            </div>
          `, '', '--go')}
          ${S.sys.miniResult?`<div class="footer-note" style="text-align:center">${esc('Ganaste el triki de '+MINIGAMES[sys.id].names+'.')}</div>`:''}
          ${prepBar()}
          ${panel(`
            ${eyebrow('Momento de conversación con el equipo y dirección', true)}
            <div class="field-label" style="text-align:center;margin-bottom:12px;margin-top:6px">¿LO DICES EN LA SALA, EN VOZ ALTA?</div>
            <div class="row">
              <button class="decision-btn pill go grow" onclick="pickQ1('YES')"><div class="dtitle">SÍ</div></button>
              <button class="decision-btn pill nogo grow" onclick="pickQ1('NO')"><div class="dtitle">NO</div></button>
            </div>
          `)}
          ${renderQueueVisual()}
        </div>
      </div>
      ${backRow()}
    `;
  }
  return `
    ${eyebrow(currentPhase().code+' · segunda decisión')}
    <h2>${esc(p.name)}, no lo vas a decir en la sala</h2>
    <div class="donow">▸ Queda una vía: avisarle solo a la directora de vuelo, en privado. La sala nunca se entera.</div>
    ${alertBanner('⚠ Avisarle a ella tampoco es gratis. Es una persona, no un buzón: puede protegerte o puede no hacerlo, y no vas a saber cuál de las dos hasta que sea tarde.')}
    ${panel(`
      <div class="field-label" style="text-align:center;margin-bottom:12px">¿SE LO DICES EN PRIVADO?</div>
      <div class="row">
        <button class="decision-btn pill cond grow" onclick="pickQ2('YES')"><div class="dtitle">SÍ</div></button>
        <button class="decision-btn pill nogo grow" onclick="pickQ2('NO')"><div class="dtitle">NO</div></button>
      </div>
    `)}
    ${backRow()}
  `;
}

function confirmLaunchDecision(){
  S.decision = 'GO';
  Anuncios?.decir?.('decisionGO');
  advanceNow();
}

function decisionNOGO(){
  S.decision = 'NO-GO';
  Anuncios?.decir?.('decisionNOGO');
  advanceNow();
}

function renderEntrega(){
  const presets = VERIF_PRESETS[S.decision] || VERIF_PRESETS.GO;
  return `
    ${eyebrow(currentPhase().code)}
    <h2>Firma y lanzamiento</h2>
    ${S.decision?`<span class="badge ${decisionClass(S.decision)}">${decisionLabel(S.decision)}</span>`:''}
    <div class="donow">▸ Elijan el mensaje que va a mandar la sala.</div>
    <div class="stack">
      ${presets.map((msg,i)=>`
        <button class="decision-btn go ${S.verifText===msg?'sel':''}" onclick="setVerifText(${i})" style="text-align:left">
          <div class="dtitle" style="justify-content:flex-start;font-size:15.5px">${esc(msg)}</div>
        </button>`).join('')}
    </div>
    ${panel(`<p style="text-align:center;color:var(--ink)">${navIcon('lock',15)} La sala firma el mensaje en conjunto, en nombre de todos.</p>`, '', '--go')}
    <div class="footer-note">La caja negra solo se abre después del lanzamiento.</div>
    <button class="primary go" onclick="finishNow()">Continuar al lanzamiento →</button>
    ${backRow(`<button class="ghost" onclick="registerRound()" ${S.savedRound?'disabled':''}>${S.savedRound?'Registrada ✓':'Registrar ya, sin lanzar'}</button>`)}
  `;
}

/* ---- launch / end sequence ---- */
function missionRing(){
  const circumference = 2*Math.PI*54;
  return `
    <div class="ignition-wrap sm">
      <svg class="ring" viewBox="0 0 120 120">
        <circle cx="60" cy="60" r="54" class="ring-track"></circle>
        <circle cx="60" cy="60" r="54" class="ring-fill" style="stroke-dasharray:${circumference};stroke-dashoffset:0"></circle>
      </svg>
      <div class="ignition sm">00:00</div>
    </div>
  `;
}
function challengerStoryHTML(){
  return `
    <p style="color:var(--ink)">El 28 de enero de 1986, la noche anterior al lanzamiento del transbordador Challenger, varios ingenieros advirtieron que las piezas de los cohetes no respondían bien con temperaturas bajas, y recomendaron no lanzar. Los escucharon. En un receso, la dirección de su propia empresa cambió la recomendación y firmó la autorización. Ninguno volvió a levantar la mano.</p>
    <p style="margin-top:10px;color:var(--nogo);font-weight:600">Al día siguiente hacía frío. Esa nave, la del Challenger, se destruyó setenta y tres segundos después de despegar. Iban siete personas.</p>
    <p style="margin-top:10px">No encontraron a un mentiroso. Encontraron una sala llena de gente que sabía una parte, pensó que probablemente no importaba, y calculó lo que le costaba decirlo una vez más.</p>
  `;
}
function challengerStoryPanel(){ return panel(challengerStoryHTML()); }
function disclosurePanels(){
  const src = (S.launch && S.launch.contributions) ? S.launch : computeRisk();
  const publicList = src.contributions.filter(c=>!c.hidden);
  const privateList = src.contributions.filter(c=>c.privateOnly);
  const hiddenList = src.contributions.filter(c=>c.hidden);
  return `
    ${publicList.length ? panel(`
      <div class="field-label" style="margin-bottom:8px">Lo que sí se dijo a tiempo</div>
      <div class="stack">
        ${publicList.map(c=>`<div class="wall-line" style="border-left-color:var(--go)">${esc(c.name)}: alguien lo dijo en voz alta, delante de todos.</div>`).join('')}
      </div>
    `) : ''}
    ${(privateList.length||hiddenList.length) ? panel(`
      <div class="field-label" style="margin-bottom:8px">Lo que la sala nunca supo</div>
      <div class="stack">
        ${privateList.map(c=>{
          const owner = S.participants.find(p=>p.cardId===c.id);
          const note = owner && owner.fired ? 'Avisó en privado, y terminó despedido por asuntos internos.' : owner && owner.credited ? 'Avisó en privado, y siguió en el equipo.' : 'Alguien avisó en privado. En la sala, nadie se enteró.';
          return `<div class="wall-line">${esc(c.name)}: ${note}</div>`;
        }).join('')}
        ${hiddenList.map(c=>`<div class="wall-line">${esc(c.name)}: no se dijo en ningún lado.</div>`).join('')}
      </div>
    `) : panel(`<p style="text-align:center;color:var(--ink)">Todo lo que se sabía se dijo, al menos en privado.</p>`)}
  `;
}
function reflectionHTML(){
  return `
    <div class="donow">▸ Toca la razón más parecida, para el muro sin nombre.</div>
    <div class="stack" style="margin-top:10px;gap:6px">
      ${REFLECTION_PRESETS.map((r,i)=>`<button class="ghost" style="text-align:left" onclick="submitPresetReflection(${i})">${esc(r)}</button>`).join('')}
    </div>
    ${S.reflectionSubmitted?`<div class="footer-note" style="margin-top:8px">Dejaste ${S.reflectionSubmitted} línea(s).</div>`:''}
  `;
}
function reflectionPanel(){ return panel(reflectionHTML()); }
function debriefButtons(){
  return `
    <button class="primary go" onclick="newCrew()">Empezar con otra tripulación</button>
  `;
}
function renderDebrief(){
  return `
    ${eyebrow('Esto no les pasó a ustedes · ocurrió de verdad, en 1986')}
    <h2>El caso Challenger</h2>
    ${challengerStoryPanel()}
    ${disclosurePanels()}
    ${reflectionPanel()}
    ${debriefButtons()}
  `;
}

function renderLaunchCountdown(){
  const total = 3;
  const circumference = 2*Math.PI*54;
  const offset = circumference * (S.launch.count/total);
  return `
    ${eyebrow('IGNICIÓN', true)}
    <div class="ignition-wrap">
      <svg class="ring" viewBox="0 0 120 120">
        <circle cx="60" cy="60" r="54" class="ring-track"></circle>
        <circle cx="60" cy="60" r="54" class="ring-fill" style="stroke-dasharray:${circumference};stroke-dashoffset:${offset}"></circle>
      </svg>
      <div class="ignition">${S.launch.count}</div>
    </div>
    ${cockpitSVG()}
    <p style="text-align:center;color:var(--ink-faint)">La sala ya no puede cambiar nada.</p>
  `;
}
function renderLaunchResolved(){
  const success = S.launch.outcome==='success';
  const causeSys = S.launch.cause!=null ? SYSTEMS.find(s=>s.id===S.launch.cause) : null;
  if(!S.launch.boxOpen){
    return `
      ${eyebrow(success?'SEÑAL NOMINAL':'PÉRDIDA DE VEHÍCULO', true)}
      <h1 class="outcome-head">${success?'La nave despegó y llegó':'La nave despegó y no llegó'}</h1>
      ${cockpitSVG()}
      ${panel(`
        <p style="text-align:center;color:var(--ink)">Toca para abrir la caja negra y ver qué pasó de verdad.</p>
        <button class="primary" style="margin-top:12px" onclick="openBlackBox()">ABRIR LA CAJA NEGRA</button>
      `, success?'flash-go':'flash-nogo')}
    `;
  }
  return `
    ${eyebrow('Esto no les pasó a ustedes · ocurrió de verdad, en 1986', true)}
    <div class="contenedor-caja-negra">
      ${panel(`
        <h1 style="margin-top:0">El caso Challenger</h1>
        <p style="color:var(--ink);margin-top:10px">
          ${success
            ? 'Esta vez no pasó nada.'
            : causeSys
              ? `Causa probable: <b>${esc(causeSys.name)}</b>. ${esc(causeSys.happened)}`
              : 'No fue por algo que se ocultó. A veces pasa, incluso cuando la sala dijo todo.'}
        </p>
        ${challengerStoryHTML()}
      `, 'tarjeta-caso')}
      ${panel(`
        <div class="indicador-row">
          ${missionRing()}
          <div>
            <div class="field-label">Estatus de la misión</div>
            <div style="color:var(--ink);font-weight:600;font-size:18px;margin-top:3px">${success?'La nave despegó y llegó':'La nave despegó y no llegó'}</div>
          </div>
        </div>
        <div class="indicador-split">
          <div style="flex:1;text-align:center">
            <div class="field-label">Retraso evitable</div>
            <div class="stat-num sm amber" style="margin-top:6px">${formatDuration(TOTAL_DELAY_HOURS)}</div>
          </div>
          <div style="flex:1;text-align:center">
            <div class="field-label">Costo de la misión</div>
            <div class="stat-num sm" style="margin-top:6px;color:${success?'var(--amber)':'var(--nogo)'}">${S.launch.risk}%</div>
          </div>
        </div>
      `, 'tarjeta-indicadores', success?'--go':'--nogo')}
    </div>
    ${debriefButtons()}
  `;
}
function renderAborted(){
  return `
    ${eyebrow('MISIÓN ABORTADA', true)}
    <h1 class="outcome-head">La nave no despegó</h1>
    ${cockpitSVG()}
    ${panel(`
      <p style="color:var(--ink)">No despegaron. La ventana se cierra, el próximo intento es en cuatro meses, y alguien tiene que explicar públicamente por qué.</p>
      <p style="margin-top:10px;color:var(--ink)"><b>No hizo falta abrir la caja negra. Evitaron la apuesta. Nunca van a saber si la nave habría llegado.</b></p>
    `)}
    ${!S.launch.boxOpen
      ? `<button class="ghost" onclick="openBlackBox()">Abrir la caja negra de todos modos</button>`
      : panel(`<div class="field-label" style="margin-bottom:8px">Caja negra</div>${blackBoxHTML()}<div class="footer-note" style="margin-top:10px">Si hubieran lanzado, el costo real habría sido del <b style="color:var(--amber)">${S.launch.risk}%</b>.</div>`)}
    ${backRow()}
    ${renderDebrief()}
  `;
}
function renderNoDecision(){
  return `
    ${eyebrow('SIN DECISIÓN', true)}
    <h1 class="outcome-head">La sala no decidió</h1>
    ${panel(`<p>No se registró GO, GO CON CONDICIÓN ni NO GO antes de que se acabara el tiempo.</p>`)}
    ${backRow()}
    ${renderDebrief()}
  `;
}
function renderEnd(){
  if(!S.launch) enterEnd();
  if(S.launch.outcome==='aborted') return renderAborted();
  if(S.launch.outcome==='none') return renderNoDecision();
  if(S.launch.stage==='countdown') return renderLaunchCountdown();
  return renderLaunchResolved();
}

function formatFecha(ts){
  const d = new Date(ts);
  return d.toLocaleDateString('es-CO', {day:'2-digit', month:'short', year:'numeric'})+' · '+d.toLocaleTimeString('es-CO', {hour:'2-digit', minute:'2-digit'});
}
function renderTablero(embedded){
  const board = loadJSON('tmenos20_tablero', []);
  const filterUI = board.length ? `
    <div class="filter-row">
      <label class="field">
        <span class="field-label">Desde</span>
        <input type="date" value="${S.tableroDesde}" onchange="setTableroDesde(this.value)">
      </label>
      <label class="field">
        <span class="field-label">Hasta</span>
        <input type="date" value="${S.tableroHasta}" onchange="setTableroHasta(this.value)">
      </label>
      ${(S.tableroDesde||S.tableroHasta) ? `<button class="ghost" style="width:auto;flex:0 0 auto" onclick="clearTableroFiltro()">Quitar filtro</button>` : ''}
    </div>
  ` : '';
  if(!board.length){
    return `${embedded?'':eyebrow('Tablero de misiones')}<h2>Tablero de misiones</h2><div class="empty">Todavía ninguna sala ha registrado su verificación.</div>`;
  }
  const desdeTs = S.tableroDesde ? new Date(S.tableroDesde+'T00:00:00').getTime() : null;
  const hastaTs = S.tableroHasta ? new Date(S.tableroHasta+'T23:59:59').getTime() : null;
  const filtered = board.filter(r=>{
    if(desdeTs!=null && r.ts < desdeTs) return false;
    if(hastaTs!=null && r.ts > hastaTs) return false;
    return true;
  });
  if(!filtered.length){
    return `
      ${embedded?'':eyebrow('Se llena a lo largo del día')}
      <h2>Tablero de misiones</h2>
      ${filterUI}
      <div class="empty">Ninguna sala registrada en ese rango de fechas.</div>
    `;
  }
  const withRisk = filtered.filter(r=>r.risk!=null);
  const avgRisk = withRisk.length ? Math.round(withRisk.reduce((a,r)=>a+r.risk,0)/withRisk.length) : 0;
  const noDespego = filtered.filter(r=>r.decision==='NOGO').length;
  const despego = filtered.filter(r=>r.decision==='GO'||r.decision==='COND').length;
  return `
    ${embedded?'':eyebrow('Se llena a lo largo del día')}
    <h2>Tablero de misiones</h2>
    <p class="lede">Las salas no compiten entre sí. Se compara qué tanto se dijo la verdad, y qué costo cargó cada una.</p>
    ${filterUI}
    ${panel(`
      <div class="stat-row">
        <div class="stat-tile"><div class="stat-num amber">${filtered.length}</div><div class="stat-label">Salas jugadas</div></div>
        <div class="stat-tile"><div class="stat-num nogo">${avgRisk}%</div><div class="stat-label">Costo promedio</div></div>
        <div class="stat-tile"><div class="stat-num accent">${noDespego}</div><div class="stat-label">No despegaron</div></div>
        <div class="stat-tile"><div class="stat-num nogo">${despego}</div><div class="stat-label">Despegaron</div></div>
      </div>
    `)}
    <div class="table-wrap">
      <table>
        <thead><tr><th>Sala</th><th>Fecha</th><th>Verif.</th><th>Nave</th><th>Público/6</th><th>Costo</th></tr></thead>
        <tbody>
          ${filtered.slice().reverse().map(r=>`
            <tr>
              <td class="num">${r.sala}</td>
              <td>${formatFecha(r.ts)}</td>
              <td><span class="badge ${decisionClass(r.decision)}">${decisionLabel(r.decision)}</span></td>
              <td class="num">${shipTag(r)}</td>
              <td class="num">${r.pub}/6</td>
              <td class="num">${r.risk!=null?r.risk+'%':'sin dato'}</td>
            </tr>`).join('')}
        </tbody>
      </table>
    </div>
  `;
}

function renderMuro(embedded){
  const wall = loadJSON('tmenos20_muro', []);
  return `
    ${embedded?'':eyebrow('Sin nombre')}
    <h2>El muro</h2>
    <p class="lede">Lo que cada tripulación dejó escrito después de su lanzamiento, sin firmar.</p>
    ${wall.length ? panel(`<div class="stack">${wall.map(l=>`<div class="wall-line">${esc(l)}</div>`).join('')}</div>`) : `<div class="empty">El muro sigue en blanco.</div>`}
  `;
}

function renderEquipoPage(){
  const started = S.participants && S.participants.length>0;
  if(!started){
    return `
      ${eyebrow('Equipo', false, '--rose')}
      <h1>Equipo</h1>
      <p class="lede">Estos son los sistemas que puede cubrir la tripulación de hoy.</p>
      ${panel(`
        <div class="field-label" style="text-align:center;margin-bottom:4px">Tripulación seleccionada (${S.selectedSystems.length}/${S.count})</div>
        <div class="roster-grid">
          ${SYSTEMS.map(sys=>{
            const picked = S.selectedSystems.includes(sys.id);
            return `<div class="roster-card ${picked?'picked':''}">${avatarSVG(sys.id,76,picked?'':'dim')}<div class="role">${esc(AVATARS[sys.id].role)}</div></div>`;
          }).join('')}
        </div>
        <div class="footer-note" style="margin-top:10px">Elige o cambia la tripulación desde Caja Negra antes de iniciar la cuenta regresiva.</div>
      `, '', '--rose')}
      <button class="ghost" onclick="setNav('cajanegra')">Ir a Caja Negra →</button>
    `;
  }
  return `
    ${eyebrow('Equipo', false, '--rose')}
    <h1>Equipo</h1>
    <p class="lede">Estado en vivo de la tripulación de esta misión.</p>
    ${panel(`
      <div class="stack" style="gap:10px">
        ${S.participants.map((p)=>{
          const sys = AVATARS[p.cardId];
          return `
          <div class="sign-row ${p.fired?'':'on'}" style="cursor:default">
            ${avatarSVG(p.cardId, 40, p.fired?'dim':'')}
            <span class="grow" style="text-align:left">
              <div style="color:var(--ink);font-weight:600">${esc(p.name)}</div>
              <div style="font-size:12px;color:var(--ink-faint)">${esc(sys?sys.role:'')}</div>
            </span>
            <span class="sign-state" style="color:${p.fired?'var(--nogo)':'var(--go)'}">${p.fired?'DESPEDIDO':'ACTIVO'}</span>
          </div>`;
        }).join('')}
      </div>
    `, '', '--rose')}
  `;
}

function renderMisionPage(){
  const started = S.participants && S.participants.length>0;
  return `
    ${eyebrow('Misión', false, '--violet')}
    <h1>Objetivo de la misión</h1>
    ${panel(`
      <div style="text-align:center">
        <div style="font-family:var(--mono);font-weight:700;font-size:19px;color:var(--amber);line-height:1.3">LLEVAR LA NAVE AL ESPACIO EN 20 MINUTOS</div>
        <div style="font-family:var(--mono);font-weight:700;font-size:13px;color:var(--ink);margin-top:8px">Y QUE TODO EL EQUIPO LLEGUE HASTA EL FINAL</div>
      </div>
    `, 'notice')}
    ${started ? panel(`
      <div class="field-label" style="text-align:center">Fase actual</div>
      <div style="text-align:center;margin-top:6px;font-size:17px;color:var(--ink);font-weight:700">${esc(currentPhase().label)}</div>
      <div class="footer-note" style="margin-top:4px">${esc(currentPhase().code)}</div>
    `, '', '--violet') : ''}
    <h2>Protocolo</h2>
    ${panel(`
      <ol class="protocol-list">
        <li><span><b>Cada uno responde por un sistema necesario para la misión.</b> Sin él, la nave no funciona. Tu carta no se muestra ni se lee en voz alta: solo se sabe lo que tú decidas contar.</span></li>
        <li><span>En la discusión, todos hablan libre. Nadie está obligado a hablar.</span></li>
        <li><span>La sala manda <b>una sola verificación</b>, firmada por todos.</span></li>
        <li><span>En el momento, <b>nadie sabe cuál es la jugada correcta</b>. Eso se sabrá después.</span></li>
      </ol>
    `, '', '--violet')}
  `;
}

function renderRecursosPage(){
  return `
    ${eyebrow('Recursos', false, '--go')}
    <h1>Recursos</h1>
    <p class="lede">Historial de salas y el muro de reflexiones, disponibles para consultar en cualquier momento.</p>
    ${panel(renderTablero(true), '', '--go')}
    ${panel(renderMuro(true), '', '--accent-2')}
  `;
}

function renderConfiguracionPage(){
  return `
    ${eyebrow('Configuración', false, '--ink-dim')}
    <h1>Configuración</h1>
    ${panel(`
      <div style="display:flex;align-items:center;justify-content:space-between;gap:12px">
        <div>
          <div style="color:var(--ink);font-weight:600">Sonido</div>
          <div style="font-size:13px;color:var(--ink-faint);margin-top:2px">Efectos de sonido de la sala de control.</div>
        </div>
        <label class="switch">
          <input type="checkbox" ${Sound.isEnabled()?'checked':''} onchange="toggleSound()">
          <span class="switch-track"><span class="switch-thumb"></span></span>
          <span>${Sound.isEnabled()?'ON':'OFF'}</span>
        </label>
      </div>
    `, '', '--accent-2')}
    ${panel(`
      <div style="color:var(--ink);font-weight:600">Reiniciar partida</div>
      <div style="font-size:13px;color:var(--ink-faint);margin-top:2px;margin-bottom:12px">Registra la sala actual (si aplica) y empieza con una tripulación nueva.</div>
      <button class="ghost" onclick="newCrew()">Empezar con otra tripulación</button>
    `, '', '--nogo')}
    <div class="footer-note">Caja Negra · POLILab, Politécnico Grancolombiano.</div>
  `;
}

function renderKey(){
  if(S.nav!=='cajanegra'){ return 'nav:'+S.nav; }
  if(S.screen==='end'){
    const l = S.launch;
    return 'end|'+(l?l.stage+'|'+l.outcome+'|'+(l.boxOpen?1:0):'');
  }
  if(S.screen!=='mission'){ return S.screen; }
  const busy = S.sys && (S.sys.deciding || S.sys.firedPending || S.sys.clearedPending || S.sys.talkPending);
  const phId = busy ? 'sistemas' : currentPhase().id;
  let extra = '';
  if(phId==='sistemas'){ extra = '|'+S.sys.idx+'|'+(S.sys.miniDone?'q':'m')+'|'+(S.sys.q1||'')+'|talk:'+(S.sys.talkPending?1:0)+'|deciding:'+(S.sys.deciding?1:0)+'|cleared:'+(S.sys.clearedPending?1:0)+'|fired:'+(S.sys.firedPending?(S.sys.firedWait>0?1:2):0); }
  return 'mission|'+phId+extra;
}
let _lastRenderKey = null;
function renderBody(){
  const body = document.getElementById('body');
  let html;
  if(S.nav==='inicio'){ html = renderInicio(); }
  else if(S.nav==='equipo'){ html = renderEquipoPage(); }
  else if(S.nav==='mision'){ html = renderMisionPage(); }
  else if(S.nav==='recursos'){ html = renderRecursosPage(); }
  else if(S.nav==='configuracion'){ html = renderConfiguracionPage(); }
  else {
    const busy = S.screen==='mission' && S.sys && (S.sys.deciding || S.sys.firedPending || S.sys.clearedPending || S.sys.talkPending);
    if(S.screen==='setup'){ html = renderSetup(); }
    else if(busy){ html = renderSistemas(); }
    else if(S.screen==='end'){ html = renderEnd(); }
    else {
      const id = currentPhase().id;
      const map = {
        lectura: renderLectura, sistemas: renderSistemas,
        entrega: renderEntrega,
      };
      html = map[id]();
    }
  }
  const key = renderKey();
  const changed = key !== _lastRenderKey;
  _lastRenderKey = key;
  body.innerHTML = '<div class="content-wrap'+(changed?' screen-in':'')+'">'+html+'</div>';
  return changed;
}

function fitScreen(){
  const stage = document.querySelector('.stage');
  const main = document.querySelector('.main');
  if(!stage || !main) return;
  stage.style.transform = 'none';
  stage.style.width = '100%';
  const availH = main.clientHeight;
  const contentH = stage.scrollHeight;
  const minScale = 0.4;
  const maxScale = 1.35;
  let scale = contentH > 0 ? availH / contentH : 1;
  if(scale > maxScale) scale = maxScale;
  if(scale < minScale){
    scale = minScale;
    main.style.overflowY = 'auto';
  } else {
    main.style.overflowY = 'hidden';
  }
  if(scale !== 1){
    stage.style.width = (100/scale) + '%';
    stage.style.transform = `scale(${scale})`;
  }
}
let _fitRaf = null;
function scheduleFit(){
  if(_fitRaf) cancelAnimationFrame(_fitRaf);
  _fitRaf = requestAnimationFrame(fitScreen);
}
let _fitTimeout = null;
function scheduleFitThorough(){
  scheduleFit();
  if(_fitTimeout) clearTimeout(_fitTimeout);
  _fitTimeout = setTimeout(fitScreen, 300);
}
window.addEventListener('resize', scheduleFitThorough);
window.addEventListener('load', scheduleFitThorough);
if(document.fonts && document.fonts.ready){ document.fonts.ready.then(scheduleFitThorough); }

function render(){ renderTopbar(); renderSidebar(); renderHUD(); const changed = renderBody(); if(changed) fitScreen(); }
render();
document.addEventListener('click', function(e){
  const btn = e.target.closest && e.target.closest('button, .seg-opt, .roster-card');
  if(!btn) return;
  const cls = btn.className || '';
  if(cls.indexOf('ttt-cell')>=0) return; // ya suena por tttTap
  if(cls.indexOf('decision-btn')>=0){
    if(cls.indexOf('go')>=0) Sound.selectGo();
    else if(cls.indexOf('nogo')>=0) Sound.selectNogo();
    else if(cls.indexOf('cond')>=0) Sound.selectCond();
    else Sound.tabClick();
  } else if(cls.indexOf('sign-row')>=0){ Sound.stamp(); }
  else if(cls.indexOf('roster-card')>=0){ Sound.tabClick(); }
  else if(cls.indexOf('tab-btn')>=0 || cls.indexOf('seg-opt')>=0 || cls.indexOf('nav-item')>=0){ Sound.tabClick(); }
  else if(cls.indexOf('primary')>=0){ Sound.primaryClick(); }
  else if(cls.indexOf('ghost')>=0){ Sound.ghostClick(); }
  else { Sound.ghostClick(); }
}, true);
</script>

</body>
</html>
