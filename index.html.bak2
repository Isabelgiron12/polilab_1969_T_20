<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Caja Negra</title>

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Outfit:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;600&display=swap">
<style>
:root{
  --void:#081c2e;
  --bg:#0f385a;
  --panel:#0b2338;
  --panel-2:#10314f;
  --border:#1c527d;
  --border-soft:#14324f;
  --ink:#ffffff;
  --ink-dim:#b9d2e4;
  --ink-faint:#7fa0bf;
  --accent:#1fb2de;
  --accent-2:#1fb2de;
  --accent-dim:#0e3b52;
  --amber:#fbaf17;
  --amber-dim:#4a3410;
  --go:#a6ce38;
  --go-dim:#2e3a12;
  --cond:#15bece;
  --cond-dim:#0e3a3f;
  --nogo:#ff5c5c;
  --nogo-dim:#3a1212;
  --violet:#a78bfa;
  --violet-dim:#241c42;
  --rose:#ec0677;
  --rose-dim:#3d0a2a;

  /* Paleta coherente de estados */
  --state-success:var(--go);
  --state-success-dim:var(--go-dim);
  --state-caution:var(--amber);
  --state-caution-dim:var(--amber-dim);
  --state-critical:var(--nogo);
  --state-critical-dim:var(--nogo-dim);
  --state-info:var(--violet);
  --state-info-dim:var(--violet-dim);
  --state-active:var(--accent-2);
  --state-active-dim:var(--accent-dim);

  --mono:'IBM Plex Mono',ui-monospace,SFMono-Regular,Menlo,monospace;
  --sans:'Outfit',system-ui,sans-serif;
  --cut:13px;
  --radius:14px;

  /* Tipografía - Escala modular (1.15) */
  --fs-xs:12px;
  --fs-sm:14px;
  --fs-base:18px;
  --fs-md:20px;
  --fs-lg:24px;
  --fs-xl:28px;
  --fs-2xl:34px;
  --fs-3xl:40px;

  /* Espaciado - Sistema de 8px base */
  --space-xs:4px;
  --space-sm:8px;
  --space-md:12px;
  --space-lg:16px;
  --space-xl:24px;
  --space-2xl:32px;

  /* Radio de esquinas */
  --radius-sm:8px;
  --radius-md:12px;
  --radius-lg:16px;

  /* Alturas de línea */
  --lh-tight:1.2;
  --lh-normal:1.4;
  --lh-relaxed:1.6;
  --lh-loose:1.75;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{-webkit-text-size-adjust:100%;text-size-adjust:100%;height:100%}
body{
  margin:0;background:var(--void);color:var(--ink);font-family:var(--sans);font-size:var(--fs-base);
  height:100vh;height:100dvh;overflow:hidden;
  background-image:radial-gradient(ellipse at 50% -12%, #16324c 0%, var(--void) 60%);
  -webkit-font-smoothing:antialiased;
  line-height:var(--lh-normal);
}

.app-shell{height:100vh;height:100dvh;display:flex;flex-direction:column}
.topbar{
  flex:0 0 auto;display:flex;align-items:center;justify-content:space-between;gap:var(--space-md);flex-wrap:wrap;
  padding:var(--space-md) calc(var(--space-lg) + env(safe-area-inset-right)) var(--space-md) calc(var(--space-lg) + env(safe-area-inset-left));
  background:linear-gradient(180deg, rgba(8,28,46,.95) 0%, rgba(8,28,46,.85) 100%);
  backdrop-filter:blur(10px);
  border-bottom:1px solid rgba(31,178,222,.1);
  box-shadow:0 8px 32px -8px rgba(0,0,0,.3);
  position:relative;z-index:30;
}
.topbar::after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:2px;background:linear-gradient(90deg, var(--accent-2), var(--amber), var(--rose), var(--violet), var(--go));filter:drop-shadow(0 0 8px rgba(31,178,222,.3))}
.topbar-brand{display:flex;align-items:center;gap:11px;min-width:0}
.brand-mark{width:36px;height:36px;border-radius:50%;background:var(--panel-2);border:1.5px solid var(--accent-2);display:flex;align-items:center;justify-content:center;color:var(--accent-2);flex:0 0 auto;box-shadow:0 0 12px -2px rgba(31,178,222,.6)}
.brand-text{font-family:var(--mono);font-weight:700;font-size:13.5px;letter-spacing:.09em;color:var(--ink);line-height:1.3;white-space:nowrap}
.brand-text small{display:block;font-size:9.5px;color:var(--ink-faint);font-weight:600;letter-spacing:.13em}

.switch{display:flex;align-items:center;gap:9px;cursor:pointer;font-family:var(--mono);font-size:10.5px;letter-spacing:.05em;color:var(--ink-dim);flex:0 0 auto}
.switch input{position:absolute;opacity:0;width:0;height:0}
.switch-track{width:36px;height:20px;border-radius:10px;background:var(--panel-2);border:1px solid var(--border);position:relative;transition:background .2s,border-color .2s;flex:0 0 auto}
.switch-thumb{position:absolute;top:1px;left:1px;width:16px;height:16px;border-radius:50%;background:var(--ink-faint);transition:transform .2s,background .2s}
.switch input:checked + .switch-track{background:var(--accent-dim);border-color:var(--accent-2)}
.switch input:checked + .switch-track .switch-thumb{transform:translateX(16px);background:var(--accent-2);box-shadow:0 0 8px var(--accent-2)}

.shell-body{flex:1;display:flex;min-height:0;min-width:0}
.sidebar{
  width:240px;flex:0 0 auto;background:var(--void);border-right:1px solid var(--border-soft);
  display:flex;flex-direction:column;gap:var(--space-xs);padding:var(--space-lg) var(--space-md);
  overflow-y:auto;
}
.nav-item{display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:10px;color:var(--ink-dim);font-family:var(--sans);font-size:14px;font-weight:500;cursor:pointer;border:1px solid transparent;background:none;width:100%;text-align:left}
.nav-item:hover{background:var(--panel-2);color:var(--ink)}
.nav-item.active{background:var(--nav-cd, var(--accent-dim));color:var(--nav-c, var(--accent-2));border-color:var(--nav-c, var(--border))}
.nav-item .nav-ic{width:18px;height:18px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;color:var(--nav-c, currentColor);opacity:.9}
.nav-item:hover .nav-ic,.nav-item.active .nav-ic{opacity:1}

.main{flex:1;min-width:0;min-height:0;display:flex;justify-content:center;overflow:hidden}
@media(max-width:1024px){
  .shell-body{flex-direction:column}
  .sidebar{width:100%;min-width:0;height:auto;position:relative;flex-direction:row;overflow-x:auto;padding:12px calc(12px + env(safe-area-inset-left)) 12px calc(12px + env(safe-area-inset-right));gap:8px;border-right:none;border-bottom:1px solid rgba(31,178,222,.1);background:linear-gradient(180deg, rgba(8,28,46,.9) 0%, rgba(11,35,56,.8) 100%)}
  .nav-item{flex:0 0 auto;white-space:nowrap;padding:10px 16px;border-radius:8px;transition:all .2s ease;background:rgba(16,49,79,.4);border:1px solid transparent}
  .nav-item:hover{background:rgba(31,178,222,.15);border-color:rgba(31,178,222,.3)}
  .nav-item.active{background:linear-gradient(135deg, rgba(31,178,222,.25) 0%, rgba(31,178,222,.1) 100%);border-color:var(--accent-2);box-shadow:0 0 12px rgba(31,178,222,.15)}
  .topbar{padding:14px var(--space-md)}
  .body{padding:var(--space-lg) var(--space-md) calc(50px + env(safe-area-inset-bottom))}
  .content-wrap{gap:18px}
}

.stage{
  max-width:none;margin:0 auto;min-height:100%;
  background:linear-gradient(135deg,#051428 0%,#0a2540 50%,#081c2e 100%);
  border-left:1px solid rgba(31,178,222,.1);border-right:1px solid rgba(31,178,222,.1);
  display:flex;flex-direction:column;position:relative;width:100%;flex-shrink:0;
  padding-left:env(safe-area-inset-left);padding-right:env(safe-area-inset-right);
  transform-origin:top center;
}
button,.decision-btn,.chip,.sign-row,.tab-btn,.seg-opt,.sysdot{touch-action:manipulation}
.stage::before{
  content:"";position:absolute;inset:0;pointer-events:none;z-index:0;
  background:
    repeating-linear-gradient(180deg,rgba(255,255,255,.012) 0px,rgba(255,255,255,.012) 1px,transparent 1px,transparent 3px),
    repeating-linear-gradient(90deg, rgba(31,178,222,.03) 0px, rgba(31,178,222,.03) 1px, transparent 1px, transparent 64px),
    repeating-linear-gradient(0deg, rgba(31,178,222,.03) 0px, rgba(31,178,222,.03) 1px, transparent 1px, transparent 64px);
  mix-blend-mode:overlay;
}
.hud:empty{display:none}
.hud{position:sticky;top:0;z-index:20;background:rgba(6,13,26,.94);-webkit-backdrop-filter:blur(7px);backdrop-filter:blur(7px);border-bottom:1px solid var(--border);padding:var(--space-md) var(--space-lg) var(--space-sm)}
.hud-top{display:flex;align-items:center;justify-content:space-between;gap:var(--space-sm);margin-bottom:var(--space-md);flex-wrap:wrap}
.wordmark{font-family:var(--mono);font-size:11px;letter-spacing:.16em;color:var(--ink-faint);text-transform:uppercase}
.wordmark b{color:var(--accent-2)}
.hud-tabs{display:flex;gap:2px}
.tab-btn{font-family:var(--mono);font-size:11px;letter-spacing:.06em;background:none;border:none;border-bottom:2px solid transparent;color:var(--ink-faint);padding:7px 10px;cursor:pointer}
.tab-btn.active{color:var(--accent-2);border-bottom-color:var(--accent-2);text-shadow:0 0 10px rgba(31,178,222,.6)}
.clock-row{display:flex;align-items:center;gap:14px}
.clock{font-family:var(--mono);font-weight:700;font-size:48px;letter-spacing:.01em;font-variant-numeric:tabular-nums;line-height:1;color:var(--amber);text-shadow:0 0 20px rgba(255,176,32,.3)}
.clock.crit{color:var(--nogo);text-shadow:0 0 20px rgba(255,92,92,.35)}
.phase-meta{display:flex;flex-direction:column;gap:3px;flex:1;min-width:0}
.phase-code{font-family:var(--mono);font-size:10px;color:var(--ink-faint);letter-spacing:.1em}
.phase-label{font-family:var(--mono);font-size:14px;color:var(--ink-dim);letter-spacing:.02em}
.rec{width:7px;height:7px;border-radius:50%;background:var(--nogo);display:inline-block;margin-right:6px;animation:blink 1.4s ease-in-out infinite}
@media(prefers-reduced-motion:reduce){.rec{animation:none}}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.25}}
.progress-track{height:4px;background:var(--border-soft);border-radius:2px;margin-top:10px;overflow:hidden}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent-2));transition:width .4s linear;box-shadow:0 0 10px var(--accent)}
.pausebtn{font-family:var(--mono);font-size:11px;letter-spacing:.06em;background:var(--panel);border:1px solid var(--border);color:var(--ink-dim);padding:8px 12px;cursor:pointer;border-radius:10px}
.pausebtn:hover{color:var(--ink)}

.body{flex:1;padding:var(--space-2xl) var(--space-lg) calc(60px + env(safe-area-inset-bottom));display:flex;flex-direction:column;position:relative;z-index:1;background:linear-gradient(135deg, rgba(15,56,90,.3) 0%, rgba(11,35,56,.2) 100%)}
.content-wrap{display:flex;flex-direction:column;gap:24px;width:100%;margin-top:auto;margin-bottom:auto}
@media(min-width:1024px){.body{padding:var(--space-2xl) 32px calc(44px + env(safe-area-inset-bottom))}}
.eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--eyebrow-c, var(--accent-2));display:flex;align-items:center;gap:0}
.outcome-eyebrow{justify-content:center}
.beacon{display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--eyebrow-c, var(--accent-2));margin-right:8px;box-shadow:0 0 7px var(--eyebrow-c, var(--accent-2));flex:0 0 auto}
h1{font-size:var(--fs-2xl);line-height:var(--lh-tight);margin:var(--space-xs) 0 var(--space-xs);text-wrap:balance;font-weight:700;letter-spacing:-.01em;color:#ffffff;text-shadow:0 2px 8px rgba(31,178,222,.2), 0 4px 16px rgba(0,0,0,.3)}
h2{font-size:var(--fs-lg);margin:0 0 var(--space-xs);text-wrap:balance;font-weight:700;letter-spacing:-.01em}
.outcome-head{font-size:var(--fs-3xl);text-align:center;margin:var(--space-xs) 0 var(--space-md)}
p{line-height:var(--lh-loose);color:var(--ink-dim);margin:0}
.lede{color:var(--ink);font-size:var(--fs-md)}
.donow{font-weight:700;color:var(--ink);font-size:var(--fs-md);line-height:var(--lh-normal);margin:0 0 var(--space-xs)}

.panel{
  position:relative;padding:var(--space-lg);
  background:linear-gradient(135deg, rgba(15,56,90,.8) 0%, rgba(11,35,56,.95) 100%);
  backdrop-filter:blur(8px);
  border:1px solid rgba(31,178,222,.15);
  border-radius:16px;
  box-shadow:0 20px 60px -10px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,.08), 0 0 1px rgba(31,178,222,.1);
  transition:all .3s ease;
}
.notice{border-left:3px solid var(--amber);background:linear-gradient(90deg,rgba(255,176,32,.08),transparent 65%)}
.panel-tint{border-left:3px solid var(--panel-accent, var(--border))}
.flash-go{animation:flashGo 1.1s ease-out 2}
.flash-nogo{animation:flashNoGo .6s ease-out 3}
@keyframes flashGo{0%,100%{box-shadow:0 0 0 1px rgba(31,178,222,.07)}50%{box-shadow:0 0 48px -8px var(--go)}}
@keyframes flashNoGo{0%,100%{box-shadow:0 0 0 1px rgba(31,178,222,.07)}50%{box-shadow:0 0 58px -6px var(--nogo)}}
@media(prefers-reduced-motion:reduce){.flash-go{animation:none;box-shadow:0 0 26px -8px var(--go)}.flash-nogo{animation:none;box-shadow:0 0 26px -8px var(--nogo)}}

.stack{display:flex;flex-direction:column;gap:var(--space-md)}
.row{display:flex;gap:var(--space-lg);flex-wrap:wrap}
.grow{flex:1;min-width:0}

button.primary{font-family:var(--sans);font-weight:700;font-size:16px;letter-spacing:.02em;background:linear-gradient(135deg, #1fb2de 0%, #0e8fb3 100%);color:#fff;border:2px solid #1fb2de;padding:18px 28px;cursor:pointer;width:100%;min-height:56px;border-radius:12px;box-shadow:0 12px 32px rgba(31,178,222,.35), inset 0 1px 0 rgba(255,255,255,.2);transition:all .3s cubic-bezier(.34,.1,.64,.92);position:relative;overflow:hidden;text-transform:uppercase;letter-spacing:.04em}
button.primary::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg, rgba(255,255,255,.1) 0%, transparent 100%);pointer-events:none}
button.primary:hover{transform:translateY(-3px);box-shadow:0 16px 48px rgba(31,178,222,.45), inset 0 1px 0 rgba(255,255,255,.3);border-color:#1fb2de}
button.primary:active{transform:translateY(-1px);box-shadow:0 8px 24px rgba(31,178,222,.35)}
button.primary:disabled{opacity:.45;cursor:not-allowed;transform:none;box-shadow:0 4px 12px rgba(31,178,222,.15)}
button.primary.go{background:linear-gradient(135deg, #a6ce38 0%, #88a820 100%);border-color:#a6ce38;box-shadow:0 12px 32px rgba(166,206,56,.35), inset 0 1px 0 rgba(255,255,255,.3)}
button.primary.go:hover{box-shadow:0 16px 48px rgba(166,206,56,.45), inset 0 1px 0 rgba(255,255,255,.4)}
button.ghost{font-family:var(--sans);font-size:15px;font-weight:600;letter-spacing:.02em;background:rgba(16,49,79,.4);color:var(--ink-dim);border:1.5px solid rgba(31,178,222,.3);padding:16px 24px;cursor:pointer;width:100%;min-height:50px;border-radius:12px;line-height:var(--lh-normal);transition:all .3s cubic-bezier(.34,.1,.64,.92);position:relative;text-transform:uppercase;letter-spacing:.03em}
button.ghost:hover{color:var(--ink);background:rgba(31,178,222,.15);border-color:var(--accent-2);box-shadow:0 8px 24px rgba(31,178,222,.25), inset 0 1px 0 rgba(255,255,255,.1);transform:translateY(-2px)}
button.ghost:active{color:var(--ink);background:rgba(31,178,222,.2);border-color:var(--accent-2);box-shadow:0 4px 12px rgba(31,178,222,.2);transform:translateY(0)}
.decision-btn:active{filter:brightness(1.3)}
.chip:active{filter:brightness(1.3)}

.launch-cta{animation:ctaPulse 2.8s cubic-bezier(.34,.1,.64,.92) infinite}
@keyframes ctaPulse{0%,100%{box-shadow:0 12px 32px rgba(166,206,56,.3), inset 0 1px 0 rgba(255,255,255,.2)}50%{box-shadow:0 20px 56px rgba(166,206,56,.5), inset 0 1px 0 rgba(255,255,255,.3)}}
@media(prefers-reduced-motion:reduce){.launch-cta{animation:none}}

.screen-in{animation:screenIn .5s cubic-bezier(.34,.1,.64,.92)}
@keyframes screenIn{0%{opacity:0;transform:translateY(20px) scale(.97)}100%{opacity:1;transform:translateY(0) scale(1)}}
@media(prefers-reduced-motion:reduce){.screen-in{animation:none}}

@keyframes glow{0%,100%{text-shadow:0 0 10px rgba(31,178,222,.3)}50%{text-shadow:0 0 20px rgba(31,178,222,.6)}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
@keyframes pulse{0%,100%{box-shadow:0 0 20px var(--accent-2)}50%{box-shadow:0 0 40px var(--accent-2)}}
.glow-text{animation:glow 3s ease-in-out infinite}
.float{animation:float 3s ease-in-out infinite}

.seg{display:flex;gap:6px}
.seg-opt{flex:1;font-family:var(--mono);font-size:17px;font-weight:600;background:var(--panel-2);border:1.5px solid var(--border);color:var(--ink-dim);padding:14px;cursor:pointer;text-align:center}
.seg-opt.active{background:var(--accent-dim);border-color:var(--accent-2);color:var(--accent-2);box-shadow:0 0 14px -6px var(--accent-2)}

label.field{display:flex;flex-direction:column;gap:var(--space-xs)}
.field-label{font-family:var(--mono);font-size:var(--fs-xs);letter-spacing:.07em;text-transform:uppercase;color:var(--ink-faint)}
input[type=text],input[type=date],textarea{font-family:var(--sans);font-size:var(--fs-base);background:var(--panel-2);border:1.5px solid var(--border);color:var(--ink);border-radius:var(--radius-sm);padding:var(--space-md) var(--space-md);width:100%}
input[type=date]{color-scheme:dark}
.filter-row{display:flex;gap:var(--space-md);flex-wrap:wrap;align-items:flex-end}
.filter-row label.field{flex:1;min-width:140px}
textarea{resize:vertical;min-height:70px;line-height:1.5}
input:focus,textarea:focus,button:focus-visible{outline:2px solid var(--accent-2);outline-offset:1px}

.card-system .name{font-family:var(--mono);font-weight:700;font-size:21px;letter-spacing:.02em;color:var(--amber)}
.card-field{border-left:3px solid var(--fc, var(--border));padding-left:12px;margin-top:13px}
.card-field:first-of-type{margin-top:13px}
.card-field-label{font-family:var(--mono);font-size:10.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--fc, var(--ink-faint))}
.card-field-body{color:var(--ink);font-size:16.5px;line-height:1.58;margin-top:3px}
.alert-banner{background:var(--amber);color:#3a2504;padding:11px 16px;border-radius:12px;font-size:13.5px;font-weight:600;line-height:1.4;text-align:center}

.chip{font-family:var(--mono);font-size:13.5px;background:var(--panel-2);border:1.5px solid var(--border);color:var(--ink-dim);border-radius:20px;padding:9px 14px}
.chip.on{background:var(--go-dim);border-color:var(--go);color:var(--go)}
.chiprow{display:flex;flex-wrap:wrap;gap:8px}

.sign-row{display:flex;align-items:center;gap:11px;width:100%;background:var(--panel-2);border:1.5px solid var(--border);padding:12px 14px;cursor:pointer;font-family:var(--sans);font-size:14.5px;color:var(--ink-dim);border-radius:12px}
.sign-row .box{flex:0 0 auto;width:18px;height:18px;border:1.5px solid var(--ink-faint)}
.sign-row.on{border-color:var(--go);background:var(--go-dim);color:var(--ink)}
.sign-row.on .box{border-color:var(--go);background:var(--go)}
.sign-row .sign-state{font-family:var(--mono);font-size:10px;letter-spacing:.04em;color:var(--ink-faint);flex:0 0 auto}
.sign-row.on .sign-state{color:var(--go)}
.sign-row:active{filter:brightness(1.25)}

.dot{display:inline-block;width:9px;height:9px;transform:rotate(45deg);flex:0 0 auto}
.dot.go{background:var(--go);box-shadow:0 0 6px var(--go)}
.dot.cond{background:var(--cond);box-shadow:0 0 6px var(--cond)}
.dot.nogo{background:var(--nogo);box-shadow:0 0 6px var(--nogo)}
.dot.dim{background:var(--ink-faint)}

.decision-btn{border:1.5px solid var(--border);padding:17px;text-align:center;cursor:pointer;background:var(--panel-2);width:100%;border-radius:12px}
.decision-btn .dtitle{font-family:var(--mono);font-weight:700;font-size:17px;letter-spacing:.02em;display:flex;align-items:center;justify-content:center;gap:9px}
.decision-btn .dsub{font-size:13.5px;color:var(--ink-faint);margin-top:4px}
.decision-btn.go{border-color:var(--go)}
.decision-btn.go.sel{background:var(--go-dim);box-shadow:0 0 20px -8px var(--go)}
.decision-btn.go .dtitle{color:var(--go)}
.decision-btn.cond{border-color:var(--cond)}
.decision-btn.cond.sel{background:var(--cond-dim);box-shadow:0 0 20px -8px var(--cond)}
.decision-btn.cond .dtitle{color:var(--cond)}
.decision-btn.nogo{border-color:var(--nogo)}
.decision-btn.nogo.sel{background:var(--nogo-dim);box-shadow:0 0 20px -8px var(--nogo)}
.decision-btn.nogo .dtitle{color:var(--nogo)}
.decision-btn.pill{border-radius:999px;padding:18px 20px}
.decision-btn.pill .dtitle{font-size:17.5px}
.decision-btn.pill.go{background:var(--go);border-color:var(--go);box-shadow:0 10px 22px -12px var(--go)}
.decision-btn.pill.go .dtitle{color:#1f2b08}
.decision-btn.pill.cond{background:var(--cond);border-color:var(--cond);box-shadow:0 10px 22px -12px var(--cond)}
.decision-btn.pill.cond .dtitle{color:#062024}
.decision-btn.pill.nogo{background:var(--rose);border-color:var(--rose);box-shadow:0 10px 22px -12px var(--rose)}
.decision-btn.pill.nogo .dtitle{color:#3a0420}

.badge{display:inline-flex;align-items:center;gap:6px;font-family:var(--mono);font-size:11.5px;letter-spacing:.05em;text-transform:uppercase;padding:5px 11px;border:1px solid;border-radius:10px}
.badge.go{color:var(--go);border-color:var(--go);background:var(--go-dim)}
.badge.cond{color:var(--cond);border-color:var(--cond);background:var(--cond-dim)}
.badge.nogo{color:var(--nogo);border-color:var(--nogo);background:var(--nogo-dim)}
.badge.dim{color:var(--ink-faint);border-color:var(--border)}

.telex{font-family:var(--mono);font-size:14.5px;line-height:1.75;background:var(--panel-2);border:1px solid var(--border);border-radius:4px;padding:15px 16px;white-space:pre-wrap}
.telex .n{color:var(--accent-2)}

.stat-row{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-md)}
@media(min-width:1024px){.stat-row{gap:var(--space-lg)}}
.stat-tile{background:linear-gradient(135deg, rgba(31,178,222,.1) 0%, rgba(16,49,79,.15) 100%);border:1.5px solid rgba(31,178,222,.2);padding:var(--space-xl);text-align:center;border-radius:16px;transition:all .3s ease;box-shadow:0 8px 24px -8px rgba(31,178,222,.1), inset 0 1px 0 rgba(255,255,255,.05)}
.stat-tile:hover{border-color:rgba(31,178,222,.4);box-shadow:0 12px 32px -6px rgba(31,178,222,.2), inset 0 1px 0 rgba(255,255,255,.08);transform:translateY(-2px)}
.stat-num{font-family:var(--mono);font-weight:700;font-size:var(--fs-3xl);font-variant-numeric:tabular-nums;line-height:1}
.stat-num.lg{font-size:44px}
.stat-num.sm{font-size:var(--fs-2xl)}
.stat-num.amber{color:var(--amber)}
.stat-num.accent{color:var(--accent-2)}
.stat-num.go{color:var(--go)}
.stat-num.cond{color:var(--cond)}
.stat-num.nogo{color:var(--nogo)}
.stat-label{font-family:var(--mono);font-size:10.5px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-faint);margin-top:7px}
.gap-line{text-align:center;font-family:var(--sans);font-size:14.5px;color:var(--ink);line-height:1.5}
.gap-line b{color:var(--amber)}

.folded-row{display:flex;flex-wrap:wrap;gap:8px}
.fold{min-width:82px;flex:1;background:var(--panel-2);border:1px solid var(--border);border-radius:10px;display:flex;align-items:center;justify-content:center;gap:6px;padding:10px 8px;font-family:var(--mono);font-size:10px;letter-spacing:.04em;color:var(--ink-faint);text-align:center;flex-direction:column}
.fold.fired{border-color:var(--nogo);color:var(--nogo);background:var(--nogo-dim)}

table{width:100%;border-collapse:collapse;font-family:var(--mono);font-size:12px}
th{text-align:left;font-size:9.5px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-faint);padding:7px 7px;border-bottom:1px solid var(--border)}
td{padding:9px 7px;border-bottom:1px solid var(--border-soft);color:var(--ink-dim);vertical-align:top}
td.num{font-variant-numeric:tabular-nums;color:var(--ink)}
.table-wrap{overflow-x:auto;border:1px solid var(--border)}
.empty{color:var(--ink-faint);font-size:14px;text-align:center;padding:30px 10px;font-style:italic}

.wall-line{font-family:var(--mono);font-size:15px;color:var(--ink);border-left:2px solid var(--amber-dim);padding:8px 0 8px 12px;line-height:1.5}

.protocol-list{display:flex;flex-direction:column;gap:11px;list-style:none;margin:0;padding:0;counter-reset:proto}
.protocol-list li{display:flex;gap:11px;font-size:16.5px;color:var(--ink-dim);line-height:1.55;counter-increment:proto}
.protocol-list li::before{content:counter(proto);font-family:var(--mono);font-weight:700;color:var(--accent-2);flex:0 0 auto}
.protocol-list li:nth-child(1)::before{color:var(--rose)}
.protocol-list li:nth-child(2)::before{color:var(--amber)}
.protocol-list li:nth-child(3)::before{color:var(--go)}
.protocol-list li:nth-child(4)::before{color:var(--violet)}
.protocol-list li b{color:var(--ink)}

.turn-name{font-family:var(--mono);font-weight:700;font-size:25px;color:var(--accent-2)}
.queue{display:flex;flex-wrap:wrap;gap:6px;justify-content:center}
.queue span{font-family:var(--mono);font-size:11.5px;color:var(--ink-faint);padding:4px 9px;border:1px solid var(--border);border-radius:12px}
.queue span.now{color:var(--accent-2);border-color:var(--accent-2)}
.queue span.done{color:var(--ink-faint);text-decoration:line-through;opacity:.5}

.sistemas-columns{display:grid;gap:14px;grid-template-columns:1fr;grid-template-areas:"turn" "triki"}
.sistemas-columns .area-turn{grid-area:turn;display:flex;flex-direction:column;justify-content:flex-start;gap:14px;min-width:0}
.sistemas-columns .area-triki{grid-area:triki;display:flex;flex-direction:column;justify-content:flex-start;gap:14px;min-width:0}

.two-col{display:grid;gap:var(--space-lg);grid-template-columns:1fr;grid-template-areas:"a" "b"}
.two-col .col-a{grid-area:a;display:flex;flex-direction:column;justify-content:center;gap:var(--space-lg);min-width:0}
.two-col .col-b{grid-area:b;display:flex;flex-direction:column;justify-content:center;gap:var(--space-lg);min-width:0}
@media(min-width:1024px){.two-col{grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);align-items:stretch;grid-template-areas:"a b"}}
.contenedor-caja-negra{display:grid;gap:14px;grid-template-columns:1fr;grid-template-areas:"caso" "indicadores"}
.tarjeta-caso{grid-area:caso;margin:0}
.tarjeta-indicadores{grid-area:indicadores;margin:0}
.indicador-row{display:flex;align-items:center;gap:14px}
.indicador-split{display:flex;gap:14px;margin-top:18px;padding-top:18px;border-top:1px solid var(--border-soft)}
@media(min-width:860px){
  .contenedor-caja-negra{grid-template-columns:1.4fr 1fr;grid-template-areas:"caso indicadores"}
  .tarjeta-caso,.tarjeta-indicadores{display:flex;flex-direction:column;justify-content:center}
}
.content-wrap > *{max-width:860px;margin-left:auto;margin-right:auto;width:100%}
.content-wrap > .inicio-columns,.content-wrap > .sistemas-columns,.content-wrap > .setup-columns,.content-wrap > .two-col,.content-wrap > .contenedor-caja-negra{max-width:none}
/* Cualquier título/eyebrow que quede justo antes de una de estas grillas de dos columnas
   debe compartir su mismo ancho completo; si no, el título queda angosto y centrado
   mientras la grilla ocupa todo el ancho, y todo se ve desalineado entre sí. */
.content-wrap > *:has(~ .inicio-columns),.content-wrap > *:has(~ .sistemas-columns),.content-wrap > *:has(~ .setup-columns),.content-wrap > *:has(~ .two-col),.content-wrap > *:has(~ .contenedor-caja-negra){max-width:none}
@media(min-width:860px){
  .sistemas-columns{grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);grid-template-areas:"turn triki";align-items:start}
}
.triki-intro{display:flex;align-items:center;gap:12px;text-align:left}
.triki-intro-ic{flex:0 0 auto;width:40px;height:40px;border-radius:12px;background:var(--amber-dim);display:flex;align-items:center;justify-content:center;color:var(--amber)}
.triki-head{display:flex;align-items:center;gap:10px}
.triki-head-ic{flex:0 0 auto;width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,var(--accent-dim),var(--rose-dim));display:flex;align-items:center;justify-content:center;color:var(--accent-2)}
.triki-head-title{font-family:var(--mono);font-weight:700;font-size:14px;letter-spacing:.06em;color:var(--ink)}
.rainbow-bar{height:4px;border-radius:2px;margin-top:10px;background:linear-gradient(90deg,var(--accent-2),var(--amber),var(--rose))}
.ttt-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;max-width:290px;margin:10px auto 0}
.ttt-status{min-height:100px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;margin-top:8px}
.ttt-status .footer-note{margin:0}
.ttt-cell{aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:34px;font-weight:700;background:var(--panel-2);border:1.5px solid var(--border);color:var(--accent-2);cursor:pointer;border-radius:12px}
.ttt-cell.filled{color:var(--ink-dim)}
.ttt-cell.win-x{border-color:var(--go);background:var(--go-dim);color:var(--go);box-shadow:0 0 14px -4px var(--go)}
.ttt-cell.win-o{border-color:var(--nogo);background:var(--nogo-dim);color:var(--nogo);box-shadow:0 0 14px -4px var(--nogo)}
.ttt-cell:disabled{cursor:default}
.ttt-cell:active{filter:brightness(1.3)}
.spinner{width:44px;height:44px;margin:0 auto;border:3px solid var(--border);border-top-color:var(--accent-2);border-radius:50%;animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
@media(prefers-reduced-motion:reduce){.spinner{animation:none;border-top-color:var(--border)}}
.ttt-cell .avatar{display:block;margin:0 auto}

.avatar .avatar-halo{fill:none;stroke:var(--ac,var(--accent-2));stroke-width:2;opacity:.8}
.avatar .avatar-collar{fill:color-mix(in srgb, var(--ac,var(--accent-2)) 60%, var(--panel-2));stroke:var(--ac,var(--accent-2));stroke-width:2.5;opacity:1}
.avatar .avatar-seam{fill:var(--ac,var(--accent-2));opacity:1}
.avatar .avatar-stud{fill:var(--ac,var(--accent-2));opacity:1}
.avatar .avatar-helmet{fill:color-mix(in srgb, var(--ac,var(--accent-2)) 25%, var(--bg));stroke:var(--ac,var(--accent-2));stroke-width:3;filter:drop-shadow(0 0 10px color-mix(in srgb, var(--ac,var(--accent-2)) 80%, transparent))}
.avatar .avatar-rim{fill:none;stroke:rgba(255,255,255,.8);stroke-width:2;stroke-linecap:round}
.avatar .avatar-badge{fill:none;stroke:var(--ac,var(--accent-2));stroke-width:3.5;stroke-linejoin:round;stroke-linecap:round;opacity:1}
.avatar .avatar-badge .fill{fill:var(--ac,var(--accent-2));stroke:none;opacity:0.9}
.avatar .avatar-shine{fill:none;stroke:rgba(255,255,255,.7);stroke-width:2.5;stroke-linecap:round}
.avatar .avatar-antenna{stroke:var(--ac,var(--accent-2));stroke-width:2.5;stroke-linecap:round}
.avatar .avatar-antenna-tip{fill:var(--ac,var(--accent-2));opacity:1}
.avatar.dim .avatar-helmet,.avatar.dim .avatar-collar,.avatar.dim .avatar-badge{stroke:var(--ink-faint);opacity:.5}
.avatar.dim .avatar-halo,.avatar.dim .avatar-rim,.avatar.dim .avatar-shine{opacity:.15}
.avatar.dim .avatar-seam,.avatar.dim .avatar-stud,.avatar.dim .avatar-antenna-tip{fill:var(--ink-faint);opacity:.4}
.avatar.dim .avatar-antenna{stroke:var(--ink-faint);opacity:.4}

.roster-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.roster-card{background:var(--panel-2);border:1.5px solid var(--border);padding:14px 10px;text-align:center;border-radius:12px;cursor:pointer;min-height:120px;display:flex;flex-direction:column;align-items:center;justify-content:center}
.roster-card:active{filter:brightness(1.25)}
.roster-card.picked{border-color:var(--accent-2);background:var(--accent-dim);box-shadow:0 0 14px -6px var(--accent-2)}
.roster-card.picked .role{color:var(--ink)}
.roster-card .role{font-size:11px;color:var(--ink-dim);margin-top:8px;line-height:1.3}

.footer-note{font-size:12.5px;color:var(--ink-faint);text-align:center;line-height:1.55}
.wcount{font-family:var(--mono);font-size:12px;color:var(--ink-faint);text-align:right}
.wcount.over{color:var(--nogo)}

.checklist{display:flex;flex-direction:column;gap:10px}
.checkline{display:flex;gap:9px;align-items:flex-start;font-size:14.5px;color:var(--ink-dim);line-height:1.55}
.checkline .box{flex:0 0 auto;width:16px;height:16px;border:1.5px solid var(--ink-faint);margin-top:2px}

.sysstrip{display:flex;gap:6px;justify-content:center;flex-wrap:wrap;margin:2px 0}
.sysdot{width:42px;height:30px;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:9px;letter-spacing:.03em;border:1px solid var(--border);color:var(--ink-faint);border-radius:10px}
.sysdot.go{border-color:var(--go);color:var(--go);background:var(--go-dim)}
.sysdot.nogo{border-color:var(--nogo);color:var(--nogo);background:var(--nogo-dim);animation:pulseRisk 1.7s ease-in-out infinite}
.sysdot.dim{opacity:.35}
@keyframes pulseRisk{0%,100%{opacity:1}50%{opacity:.5}}
@media(prefers-reduced-motion:reduce){.sysdot.nogo{animation:none}}

.ignition-wrap{position:relative;width:180px;height:180px;margin:8px auto 0}
.ignition-wrap.sm{width:116px;height:116px;margin:0;flex:0 0 auto}
.ring{width:100%;height:100%;transform:rotate(-90deg)}
.ring-track{fill:none;stroke:var(--border);stroke-width:4}
.ring-fill{fill:none;stroke:var(--accent-2);stroke-width:4;stroke-linecap:round;transition:stroke-dashoffset .85s linear;filter:drop-shadow(0 0 8px rgba(31,178,222,.7))}
.ignition{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-weight:700;font-size:64px;color:var(--accent-2);text-shadow:0 0 26px rgba(31,178,222,.5)}
.ignition.sm{font-size:21px}

.rocket .hull,.rocket .fin{fill:var(--panel-2);stroke:var(--accent-2);stroke-width:2}
.rocket .hull-sheen{stroke:none}
.rocket .nose-shade{fill:var(--accent-2);opacity:.14}
.rocket .hull-seam{stroke:var(--accent-2);stroke-width:1;opacity:.4;fill:none}
.rocket .window-ring{fill:none;stroke:var(--accent-2);stroke-width:1;opacity:.4}
.rocket .window{fill:var(--bg);stroke:var(--accent-2);stroke-width:2}
.rocket .window-cross{stroke:var(--accent-2);stroke-width:1;opacity:.5}
.rocket .hatch{fill:none;stroke:var(--accent-2);stroke-width:1.5;opacity:.55}
.rocket .flame-outer{fill:var(--amber);opacity:.3;transform-origin:50px 128px;filter:blur(1px)}
.rocket .flame{fill:var(--amber);opacity:.88;transform-origin:50px 126px}
.rocket .flame-core{fill:#fff6d8;opacity:.85;transform-origin:50px 122px}
.rocket .smoke{fill:var(--ink-faint);opacity:.16}
.rocket.state-idle .flame,.rocket.state-idle .flame-outer{opacity:.2}
.rocket.state-idle .flame-core{opacity:.12}
.rocket.state-idle .smoke{opacity:.05}
.rocket.state-countdown .flame,.rocket.state-countdown .flame-outer,.rocket.state-countdown .flame-core{animation:flick .35s ease-in-out infinite alternate}
.rocket.state-countdown .smoke,.rocket.state-success .smoke{animation:smokeDrift 1.1s ease-in-out infinite alternate}
@keyframes flick{from{transform:scaleY(.85)}to{transform:scaleY(1.2)}}
@keyframes smokeDrift{from{opacity:.14;transform:translateY(0) scale(1)}to{opacity:.36;transform:translateY(-4px) scale(1.12)}}
.rocket.state-success .hull,.rocket.state-success .fin,.rocket.state-success .hull-seam,.rocket.state-success .window-ring,.rocket.state-success .window,.rocket.state-success .window-cross,.rocket.state-success .hatch{stroke:var(--go)}
.rocket.state-success .flame,.rocket.state-success .flame-outer{fill:var(--go)}
.rocket.state-failure .hull,.rocket.state-failure .fin,.rocket.state-failure .hull-seam,.rocket.state-failure .window-ring,.rocket.state-failure .window,.rocket.state-failure .window-cross,.rocket.state-failure .hatch{stroke:var(--nogo)}
.rocket.state-failure .flame,.rocket.state-failure .flame-outer{fill:var(--nogo);opacity:.35}
.rocket.state-failure .flame-core{opacity:.25}
.rocket .crack{stroke:var(--nogo);stroke-width:2.5}
@media(prefers-reduced-motion:reduce){.rocket .flame{animation:none!important}.rocket .smoke{animation:none!important}}

.cockpit{display:block;margin:10px auto 4px;width:100%;max-width:800px;height:auto}
.setup-columns{display:grid;gap:14px;grid-template-columns:1fr;grid-template-areas:"cockpit" "role" "count" "roster"}
.setup-columns .area-cockpit{grid-area:cockpit;display:flex;align-items:center;justify-content:center;min-width:0}
.setup-columns .area-role{grid-area:role;min-width:0}
.setup-columns .area-count{grid-area:count;min-width:0}
.setup-columns .area-roster{grid-area:roster;min-width:0}
@media(min-width:860px){
  .setup-columns{grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);grid-template-areas:"cockpit role" "cockpit count" "cockpit roster"}
  .setup-columns .cockpit{max-width:none}
}
.cockpit .cp-frame{fill:var(--panel-2);stroke:var(--accent-2);stroke-width:2}
.cockpit .cp-rivet{fill:var(--accent-2);opacity:.5}
.cockpit .cp-star{fill:var(--ink-dim)}
.cockpit .cp-star.dim{fill:var(--ink-faint);opacity:.5}
.cockpit .cp-glow{opacity:.9}
.cockpit .cp-disk-back{fill:none;stroke:var(--amber);stroke-width:2;opacity:.3}
.cockpit .cp-disk-front{fill:none;stroke:var(--amber);stroke-width:4;stroke-linecap:round;filter:drop-shadow(0 0 6px rgba(255,176,32,.7))}
.cockpit .cp-void{fill:#03050a;stroke:var(--accent-2);stroke-width:1.5;opacity:.85}
.cockpit .cp-panel{fill:var(--panel);stroke:var(--border);stroke-width:1.5}
.cockpit .cp-led{opacity:.9}
.cockpit .cp-led.go{fill:var(--go)}
.cockpit .cp-led.warn{fill:var(--amber)}
.cockpit .cp-led.blink{animation:pulseRisk 1.7s ease-in-out infinite}
@media(prefers-reduced-motion:reduce){.cockpit .cp-led.blink{animation:none}}

.poli-mark{display:block}
.topbar-brand .poli-mark{height:38px;width:auto}
.sound-ic{color:var(--ink-dim);display:flex;align-items:center;flex:0 0 auto}

.breadcrumb{font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-faint);margin-bottom:2px}
.breadcrumb b{color:var(--ink-dim);font-weight:600}
.breadcrumb .sep{margin:0 8px;color:var(--border)}

.inicio-columns{display:grid;gap:20px;grid-template-columns:1fr;grid-template-areas:"crumb" "text" "showcase"}
.inicio-columns .area-crumb{grid-area:crumb;min-width:0}
.inicio-columns .area-text{grid-area:text;display:flex;flex-direction:column;gap:13px;min-width:0}
.inicio-columns .area-showcase{grid-area:showcase;min-width:0}
@media(min-width:900px){
  .inicio-columns{grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);grid-template-areas:"crumb crumb" "text showcase";align-items:stretch}
}
.inicio-title{font-size:38px;line-height:1.05;margin:2px 0 0;font-weight:700;letter-spacing:-.01em}
.inicio-subtitle{font-family:var(--mono);font-size:12px;letter-spacing:.14em;color:var(--accent-2);text-transform:uppercase;margin:2px 0 4px}

.creado-panel{display:flex;align-items:center;gap:14px}
.creado-panel .creado-ic{flex:0 0 auto;width:38px;height:38px;border-radius:50%;background:var(--rose-dim);display:flex;align-items:center;justify-content:center;color:var(--rose)}
.creado-panel .creado-body{flex:1;min-width:0;text-align:left}
.creado-panel .creado-name{color:var(--ink);font-weight:600;margin-top:3px}
.creado-panel .creado-year{color:var(--accent-2);margin-top:5px;font-size:13px}
.creado-panel .creado-bank{flex:0 0 auto;color:var(--ink-faint);opacity:.55}

.showcase-card{position:relative;min-height:260px;height:100%;border-radius:16px;border:1px solid var(--border);background:linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,0) 40%), radial-gradient(ellipse at 50% 12%, #10314f 0%, var(--panel) 70%);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24px;padding:30px 16px;overflow:hidden;box-shadow:0 0 0 1px rgba(31,178,222,.07), 0 18px 40px -22px rgba(0,0,0,.85)}
.showcase-card::before{content:"";position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg, var(--accent-2), var(--amber), var(--rose), var(--violet), var(--go))}
.showcase-card .poli-mark{height:64px}
.showcase-tags{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-dim);display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:center}
.showcase-tags .sep{color:var(--accent-2)}

.orbit-wrap{width:180px;height:180px;margin:0 auto}
.orbit-wrap svg{width:100%;height:100%;display:block}
.orbit-spin{animation:orbitSpin 16s linear infinite;transform-origin:60px 60px}
@keyframes orbitSpin{to{transform:rotate(360deg)}}
@media(prefers-reduced-motion:reduce){.orbit-spin{animation:none}}

.dev-navigator{position:fixed;bottom:24px;right:24px;background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:12px 16px;z-index:40;font-family:var(--mono);font-size:12px;box-shadow:0 8px 32px rgba(0,0,0,.4)}
.dev-navigator-label{color:var(--ink-dim);margin-bottom:8px;text-align:center;letter-spacing:.05em}
.dev-navigator-controls{display:flex;gap:8px;align-items:center;justify-content:center}
.dev-nav-btn{background:var(--accent-dim);color:var(--accent-2);border:1px solid var(--accent-2);border-radius:6px;padding:6px 10px;cursor:pointer;font-family:var(--mono);font-size:11px;transition:all .15s}
.dev-nav-btn:hover{background:var(--accent-2);color:var(--void)}
.dev-nav-select{background:var(--panel-2);color:var(--ink);border:1px solid var(--border);border-radius:6px;padding:6px 8px;cursor:pointer;font-family:var(--mono);font-size:11px;transition:all .15s}
.dev-nav-select:hover{border-color:var(--accent-2)}

::selection{background:var(--accent-dim);color:var(--ink)}

.toast-container{position:fixed;bottom:24px;right:24px;z-index:100;display:flex;flex-direction:column;gap:12px;pointer-events:none}
.toast{display:flex;align-items:flex-start;gap:12px;padding:14px 16px;border-radius:12px;font-family:var(--sans);font-size:14px;line-height:1.4;box-shadow:0 12px 32px rgba(0,0,0,.4);animation:toastSlideIn .3s cubic-bezier(.34,.1,.64,.92);pointer-events:auto;max-width:320px;min-width:280px}
.toast-icon{flex:0 0 auto;width:20px;height:20px;display:flex;align-items:center;justify-content:center;font-weight:700}
.toast-go{background:linear-gradient(135deg,rgba(166,206,56,.2),rgba(166,206,56,.1));border:1px solid var(--go);color:var(--ink)}
.toast-go .toast-icon{color:var(--go)}
.toast-caution{background:linear-gradient(135deg,rgba(251,175,23,.2),rgba(251,175,23,.1));border:1px solid var(--amber);color:var(--ink)}
.toast-caution .toast-icon{color:var(--amber)}
.toast-critical{background:linear-gradient(135deg,rgba(255,92,92,.2),rgba(255,92,92,.1));border:1px solid var(--nogo);color:var(--ink)}
.toast-critical .toast-icon{color:var(--nogo);animation:pulse 1.5s ease-in-out infinite}
@keyframes toastSlideIn{from{transform:translateX(360px);opacity:0}to{transform:translateX(0);opacity:1}}
@keyframes toastSlideOut{from{transform:translateX(0);opacity:1}to{transform:translateX(360px);opacity:0}}
</style>
<script src="anuncios.js"></script>
</head>
<body>


<div class="app-shell">
  <div class="topbar" id="topbar"></div>
  <div class="shell-body">
    <aside class="sidebar" id="sidebar"></aside>
    <div class="main">
      <div class="stage">
        <div class="hud" id="hud"></div>
        <div class="body" id="body"></div>
        <div id="devNav"></div>
      </div>
    </div>
  </div>
</div>

<div class="toast-container" id="toastContainer"></div>

<script>
function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

function showToast(msg, type='go', duration=4000){
  const container = document.getElementById('toastContainer');
  const icons = {go:'✓', caution:'!', critical:'⚠'};
  const toast = document.createElement('div');
  toast.className = `toast toast-${type}`;
  toast.innerHTML = `<div class="toast-icon">${icons[type]}</div><div>${esc(msg)}</div>`;
  container.appendChild(toast);
  setTimeout(()=>{
    toast.style.animation = 'toastSlideOut .3s cubic-bezier(.34,.1,.64,.92) forwards';
    setTimeout(()=>toast.remove(), 300);
  }, duration);
}

const Sound = (function(){
  let ctx = null, master = null, enabled = true, reverb = null, noiseBuf = null;

  function ensure(){
    if(ctx){
      if(ctx.state==='suspended') ctx.resume();
      return;
    }
    try{
      const AC = window.AudioContext || window.webkitAudioContext;
      if(!AC) return;
      ctx = new AC();
      master = ctx.createGain();
      master.gain.value = enabled ? 0.68 : 0;
      master.connect(ctx.destination);
      buildNoise();
      buildReverb();
      if(ctx.state==='suspended') ctx.resume();
    }catch(e){ ctx = null; }
  }
  function buildNoise(){
    const len = ctx.sampleRate * 1.5;
    noiseBuf = ctx.createBuffer(1, len, ctx.sampleRate);
    const d = noiseBuf.getChannelData(0);
    for(let i=0;i<len;i++) d[i] = Math.random()*2-1;
  }
  function buildReverb(){
    reverb = ctx.createGain();
    reverb.gain.value = 1;
    const damp = ctx.createBiquadFilter(); damp.type='lowpass'; damp.frequency.value=2400;
    damp.connect(master);
    [[0.041,0.32],[0.067,0.26],[0.101,0.2],[0.139,0.15]].forEach(([t,fb])=>{
      const dl = ctx.createDelay(1); dl.delayTime.value = t;
      const g = ctx.createGain(); g.gain.value = fb;
      reverb.connect(dl); dl.connect(g); g.connect(dl); dl.connect(damp);
    });
  }
  function sendReverb(node, amount){
    if(!reverb) return;
    const send = ctx.createGain(); send.gain.value = amount==null?0.4:amount;
    node.connect(send); send.connect(reverb);
  }
  function sweep(f0, f1, dur, type, gainVal, delay, opts){
    if(!ctx || !enabled) return;
    opts = opts || {};
    const t0 = ctx.currentTime + (delay||0);
    const osc = ctx.createOscillator();
    osc.type = type || 'sine';
    osc.frequency.setValueAtTime(Math.max(20,f0), t0);
    osc.frequency.exponentialRampToValueAtTime(Math.max(20,f1), t0+dur*0.72);
    const filt = ctx.createBiquadFilter();
    filt.type = 'lowpass';
    filt.frequency.setValueAtTime(opts.filterStart||6000, t0);
    if(opts.filterEnd) filt.frequency.exponentialRampToValueAtTime(Math.max(80,opts.filterEnd), t0+dur);
    const g = ctx.createGain();
    g.gain.setValueAtTime(0, t0);
    g.gain.linearRampToValueAtTime(gainVal||0.14, t0+0.006);
    g.gain.exponentialRampToValueAtTime(0.0001, t0+dur);
    osc.connect(filt); filt.connect(g); g.connect(master);
    if(opts.reverb) sendReverb(g, opts.reverb);
    osc.start(t0); osc.stop(t0+dur+0.03);
  }
  function noiseHit(dur, gainVal, freq, q, delay){
    if(!ctx || !enabled) return;
    const t0 = ctx.currentTime + (delay||0);
    const src = ctx.createBufferSource(); src.buffer = noiseBuf;
    const filt = ctx.createBiquadFilter(); filt.type='bandpass'; filt.frequency.value = freq||1800; filt.Q.value = q||3;
    const g = ctx.createGain();
    g.gain.setValueAtTime(0, t0);
    g.gain.linearRampToValueAtTime(gainVal||0.1, t0+0.004);
    g.gain.exponentialRampToValueAtTime(0.0001, t0+dur);
    src.connect(filt); filt.connect(g); g.connect(master);
    src.start(t0); src.stop(t0+dur+0.02);
  }

  return {
    primaryClick(){ ensure(); sweep(420,760,0.1,'sine',0.075,0,{filterStart:900,filterEnd:3400,reverb:0.1}); noiseHit(0.03,0.02,3600,5,0.01); },
    ghostClick(){ ensure(); sweep(620,480,0.05,'triangle',0.04,0,{filterStart:2200}); },
    tabClick(){ ensure(); sweep(900,820,0.04,'sine',0.04,0,{filterStart:2800}); },
    selectGo(){ ensure(); sweep(460,780,0.1,'sine',0.08,0,{filterStart:900,filterEnd:3000,reverb:0.1}); },
    selectCond(){ ensure(); sweep(420,580,0.09,'sine',0.075,0,{filterStart:900,filterEnd:2000,reverb:0.07}); },
    selectNogo(){ ensure(); sweep(380,220,0.14,'triangle',0.07,0,{filterStart:1100,filterEnd:380,reverb:0.09}); },
    stamp(){ ensure(); noiseHit(0.055,0.05,700,2.4,0); sweep(210,150,0.08,'sine',0.04,0.008); },
    placeX(){ ensure(); sweep(650,940,0.08,'sine',0.08,0,{filterStart:3600,reverb:0.08}); },
    placeO(){ ensure(); sweep(300,210,0.08,'sine',0.07,0,{filterStart:2200}); },
    win(){ ensure(); [0,0.09,0.18].forEach((d,i)=>sweep([660,880,1108][i],[672,892,1120][i],0.15,'sine',0.09,d,{filterStart:3400,reverb:0.14})); },
    lose(){ ensure(); sweep(320,170,0.24,'triangle',0.07,0,{filterStart:1000,filterEnd:280,reverb:0.1}); },
    tick(){ ensure(); sweep(520,500,0.045,'sine',0.06,0,{filterStart:2400}); noiseHit(0.02,0.015,3000,8,0); },
    success(){ ensure(); [0,0.1,0.22].forEach((d,i)=>sweep([523,659,880][i],[531,668,890][i],0.24,'sine',0.1,d,{filterStart:3200,reverb:0.2})); },
    failure(){ ensure(); sweep(240,70,0.46,'triangle',0.08,0,{filterStart:1000,filterEnd:130,reverb:0.2}); noiseHit(0.24,0.045,260,1.5,0.05); },
    fired(){ ensure(); sweep(210,95,0.32,'sine',0.07,0,{filterStart:700,filterEnd:170,reverb:0.12}); noiseHit(0.1,0.03,420,2,0.04); },
    cleared(){ ensure(); sweep(540,780,0.15,'sine',0.075,0,{filterStart:1100,filterEnd:2800,reverb:0.14}); },
    toggle(){
      enabled = !enabled;
      if(ctx) master.gain.setTargetAtTime(enabled?0.68:0, ctx.currentTime, 0.05);
      return enabled;
    },
    isEnabled(){ return enabled; }
  };
})();
function toggleSound(){ Sound.toggle(); render(); }

const SYSTEMS = [
  {id:1, name:'PROPULSIÓN', weight:20, does:'Responder por los motores.',
   happened:'La válvula que falló hace dos semanas ya se cambió. El protocolo pedía repetir la prueba en frío después del cambio, no alcanzó a hacerse por la ventana de lanzamiento. La pieza pasó sin problema todas las demás pruebas.',
   costs:'La firma de que no hacía falta repetir la prueba en frío es tuya.'},
  {id:2, name:'OXÍGENO', weight:12, does:'Responder por el aire de la tripulación.',
   happened:'El cálculo de consumo da el margen justo para nueve días, exacto, sin margen adicional. Nadie más lo ha revisado todavía, y quien lo hizo confía en él.',
   costs:'Nadie más ha revisado tu cálculo todavía.'},
  {id:3, name:'NAVEGACIÓN', weight:10, does:'Responder por el rumbo y por el sistema de respaldo.',
   happened:'El sistema de respaldo pasó sin errores la última prueba, ayer. Antes de eso, tres días seguidos con un error intermitente que nadie más alcanzó a ver repetirse.',
   costs:'Llevas tres días viendo el mismo error sin decir nada.'},
  {id:4, name:'COMUNICACIONES', weight:8, does:'Responder por el contacto con la nave.',
   happened:'La antena secundaria quedó desalineada dos grados en el último ajuste. Solo se usa si la principal falla, y eso no ha pasado en las últimas veinte misiones.',
   costs:'Arreglarlo son ocho horas que ya no quedan.'},
  {id:5, name:'ESCUDO TÉRMICO', weight:18, does:'Responder por el reingreso de la nave.',
   happened:'En la inspección viste una marca del tamaño de una uña en una placa. El manual no es específico sobre marcas de ese tamaño, pide usar criterio. El técnico que la revisó contigo lleva quince años en el puesto, dice que la ha visto muchas veces y nunca fue un problema.',
   costs:'El técnico con más experiencia ya lo revisó y dijo que no era nada.'},
  {id:6, name:'SOPORTE VITAL', weight:10, does:'Responder por los filtros y las provisiones.',
   happened:'Los filtros de repuesto llegaron de un lote distinto al habitual, sin el certificado de calidad que exige el protocolo. Los probaste tú mismo con el equipo del laboratorio y dieron los mismos valores que los certificados.',
   costs:'Si lo dices, el reemplazo certificado tarda semanas, y todo el cronograma se mueve con él.'},
];
const POOL_BY_COUNT = {6:[1,2,3,4,5,6], 5:[1,2,3,5,6], 4:[1,2,3,5], 3:[1,2,5], 2:[1,5]};
const HIDDEN_P = {1:0.45, 2:0.30, 3:0.25, 4:0.20, 5:0.40, 6:0.25};
const MINIGAMES = {
  1:{title:'Triki de los motores', names:'los motores'},
  2:{title:'Triki del flujo de aire', names:'el flujo de aire'},
