const AVATARS = {
  1:{role:'Jefatura de Propulsión', ability:'Conoce cada motor de la nave, tornillo por tornillo.', color:'var(--amber)'},
  2:{role:'Jefatura de Oxígeno', ability:'Cuenta cada litro de aire de la tripulación.', color:'var(--accent-2)'},
