  5:{title:'Triki del ángulo de reentrada', names:'el ángulo de reentrada'},
  6:{title:'Triki de la presión de cabina', names:'la presión de cabina'},
};
const FIRE_REASONS = [
  'una reestructuración del área',
  'recorte de personal por presupuesto',
  'una evaluación interna',
  'un cambio en la política de la empresa',
  'decisión del comité directivo',
